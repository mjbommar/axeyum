@typing.final
class TermNode:
    r"""
    One structural node of a term, copied out of the arena.
    
    Owned, so a Python walker can hold it while the arena keeps being built.
    """
    @property
    def kind(self) -> builtins.str:
        r"""
        `"bool_const"`, `"bv_const"`, `"int_const"`, `"real_const"`, `"symbol"`
        or `"app"`.
        """
    @property
    def op(self) -> typing.Optional[builtins.str]:
        r"""
        The operator name for an `"app"` node, else `None`.
        """
    @property
    def op_params(self) -> dict:
        r"""
        Parameters the operator carries itself (`extract`'s `hi`/`lo`, a
        quantifier's bound `var`, …). Empty for un-parameterized operators.
        """
    @property
    def args(self) -> tuple:
        r"""
        The argument terms of an `"app"` node, in order.
        """
    @property
    def symbol(self) -> typing.Optional[Symbol]:
        r"""
        The declared symbol of a `"symbol"` node, else `None`.
        """
    @property
    def value(self) -> typing.Optional[typing.Any]:
        r"""
        The constant a `"*_const"` node carries, else `None`.
        """
    def __repr__(self) -> builtins.str: ...

@typing.final
class TermStats:
    r"""
    Structural statistics over a set of root terms.
    """
    @property
    def dag_nodes(self) -> builtins.int:
        r"""
        Distinct nodes reachable from the roots (the shared DAG size).
        """
    @property
    def tree_nodes(self) -> builtins.int:
        r"""
        Nodes the same formula would have with no sharing.
        """
    @property
    def max_depth(self) -> builtins.int:
        r"""
        Longest root-to-leaf path.
        """
    @property
    def distinct_symbols(self) -> builtins.int:
        r"""
        Distinct declared symbols reachable from the roots.
        """
    @property
    def ite_count(self) -> builtins.int:
        r"""
        `ite` nodes reachable from the roots.
        """
    @property
    def mul_div_count(self) -> builtins.int:
        r"""
        Multiplication/division nodes reachable from the roots.
        """
    def sharing_ratio(self) -> builtins.float:
        r"""
        `tree_nodes / dag_nodes` — how much the DAG representation buys.
        """
    def __repr__(self) -> builtins.str: ...

def eval(arena: Arena, term: Term, assignment: Assignment) -> typing.Any:
    r"""
    Evaluates `term` under `assignment` — the trusted ground evaluator.
    
    This is the checker, not a solver: it is total on ground terms whose
    symbols are all bound, and it reports an error rather than a wrong value
    when a result leaves the `i128` reference range.
    
    SMT-LIB totality holds here verbatim, so `eval` of `(bvudiv x 0)` is
    all-ones and `eval` of `(div a 0)` is `0` — no `ZeroDivisionError` is
    raised for either.
    
    # Errors
    
    Raises `SortError` for an unbound symbol, an un-enumerable quantifier
    domain, or an arithmetic overflow.
    """

def well_founded_default(arena: Arena, sort: Sort) -> typing.Optional[typing.Any]:
    r"""
    A canonical inhabitant of `sort`, or `None` for a sort with none.
    """


# Accepted divergence between ./scripts/check.sh and `just check`.
# Regenerate with: scripts/check-aggregate-scope.sh --update
# A step listed here runs on ONE side only. Removing an entry (making the
# two agree) is always fine; ADDING one is a new blind spot in whichever
# gate a contributor happens to run, so the gate fails until it is recorded
# here deliberately.
check.sh-only: python3 scripts/query-rules-as-code.py coverage --by domain --require-any
check.sh-only: python3 scripts/query-rules-as-code.py coverage --by fragment --format json --require-any
check.sh-only: python3 scripts/query-rules-as-code.py coverage --by validation --require-any
check.sh-only: scripts/check-clippy-complete.sh
just-only:     cargo test -p axeyum-cas --lib -- --ignored
just-only:     mkdir -p "${TMPDIR:-/data0/axeyum/scratch/py-tmp-$USER}"
just-only:     python3 -m unittest scripts.tests.test_analyze_bit_lowering_memo_profile
just-only:     python3 -m unittest scripts.tests.test_analyze_bit_lowering_memo_timing
just-only:     python3 -m unittest scripts.tests.test_analyze_glaurung_paired_traces
just-only:     python3 -m unittest scripts.tests.test_analyze_glaurung_profiled_trace

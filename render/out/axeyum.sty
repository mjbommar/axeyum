% axeyum.sty -- generated by axeyum-render; safe to redefine, do not rename.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{axeyum}[2026/08/21 Axeyum rendered-evidence macros]
\RequirePackage{hyperref}
\RequirePackage{xcolor}

% \axbadge{STATUS} -- the epistemic-status badge. The token is rendered
% verbatim; it is data from the fact ledger and must not be paraphrased.
\newcommand{\axbadge}[1]{\textsc{\footnotesize[#1]}}

% \axclaim{label}{STATUS} -- a claim header. Use inside axclaimbox.
\newcommand{\axclaim}[2]{\par\noindent\textbf{Claim --- #1}\quad\axbadge{#2}\par\nopagebreak}
\newenvironment{axclaimbox}{\par\medskip\begin{quote}}{\end{quote}\par\medskip}

% \axstatement{key}{title} -- a statement of record pulled by checked reference.
\newcommand{\axstatement}[2]{\par\medskip\noindent\textbf{#2}\quad\texttt{\footnotesize #1}\par\nopagebreak}

% axtable{caption}{source} -- a table with the provenance of the run behind it.
\newenvironment{axtable}[2]{%
  \par\medskip\noindent\textbf{#1}\par\nopagebreak
  \def\axtablesource{#2}%
  \centering
}{%
  \par\noindent\footnotesize Source: \axtablesource.\par\medskip
}

% \axcert{kind}{summary} -- a checkable artifact presented as such.
\newcommand{\axcert}[2]{\par\medskip\noindent\textbf{Certificate --- #1}\par\nopagebreak #2\par}
\newcommand{\axreplay}[1]{\par\noindent\footnotesize Replay: \texttt{#1}\par\medskip}

% \axfigure{alt}{path}, \axfiguredata{alt} -- figures.
\newcommand{\axfigure}[2]{\par\medskip\noindent\framebox{\parbox{0.9\linewidth}{Figure: #1\par\href{#2}{\texttt{#2}}}}\par\medskip}
\newcommand{\axfiguredata}[1]{\par\medskip\noindent\textit{Figure (#1) --- data:}\par\nopagebreak}

% \axarchive{label}{url} -- archive tier: the content is not in the document.
\newcommand{\axarchive}[2]{\par\noindent\textit{Archived --- \href{#2}{#1} (not shown here).}\par\medskip}

% \axdetailref{n}{summary}, \axdetail{n}{summary} -- appendix detail mode.
\newcommand{\axdetailref}[2]{\par\noindent\footnotesize Detail #1 (#2) appears at the end.\par\medskip}
\newcommand{\axdetail}[2]{\par\medskip\noindent\textbf{Detail #1 --- #2}\par\nopagebreak}
\endinput

{
  "format": "axeyum-geometry-certificate",
  "version": 1,
  "id": "euler-line",
  "title": "Euler's line: circumcentre, centroid and orthocentre are collinear",
  "statement": "Let O satisfy |OA| = |OB| = |OC| (the circumcentre), let H satisfy AH perpendicular to BC and BH perpendicular to CA (the orthocentre), let G = (A+B+C)/3 (the centroid), and let A, B, C NOT be collinear. Then O, G and H are collinear. The non-degeneracy condition is essential: when two vertices coincide the hypotheses stop determining O and H, and O, G, H are in general a genuine triangle.",
  "coordinate_gloss": [["ax", "A.x"], ["ay", "A.y"], ["bx", "B.x"], ["by", "B.y"], ["cx", "C.x"], ["cy", "C.y"], ["ox", "O (circumcentre).x"], ["oy", "O (circumcentre).y"], ["hx", "H (orthocentre).x"], ["hy", "H (orthocentre).y"]],
  "coordinates": ["ax", "ay", "bx", "by", "cx", "cy", "hx", "hy", "ox", "oy"],
  "hypotheses": [

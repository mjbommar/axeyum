    {"id": "ab-equals-bc", "description": "|AB| = |BC|", "poly": {"terms": [{"monomial": [["ax", 1], ["bx", 1]], "coefficient": [-2, 1]}, {"monomial": [["ax", 2]], "coefficient": [1, 1]}, {"monomial": [["ay", 1], ["by", 1]], "coefficient": [-2, 1]}, {"monomial": [["ay", 2]], "coefficient": [1, 1]}, {"monomial": [["bx", 1], ["cx", 1]], "coefficient": [2, 1]}, {"monomial": [["by", 1], ["cy", 1]], "coefficient": [2, 1]}, {"monomial": [["cx", 2]], "coefficient": [-1, 1]}, {"monomial": [["cy", 2]], "coefficient": [-1, 1]}]}}

{
  "format": "axeyum-geometry-certificate",
  "version": 1,
  "id": "rhombus-diagonals-perpendicular",
  "title": "the diagonals of a rhombus are perpendicular",
  "statement": "If AB is parallel to DC, BC is parallel to AD, |AB| = |BC|, and A, B, D are NOT collinear, then AC is perpendicular to BD. Without the non-degeneracy condition the statement is false: four collinear points with |AB| = |BC| satisfy every hypothesis and their diagonals are parallel, not perpendicular.",
  "coordinate_gloss": [["ax", "A.x"], ["ay", "A.y"], ["bx", "B.x"], ["by", "B.y"], ["cx", "C.x"], ["cy", "C.y"], ["dx", "D.x"], ["dy", "D.y"]],

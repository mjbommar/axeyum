; ICU night roster, one ward, one week -- INFEASIBLE.
;
; 6 nurses (alice bob cara dev eli fern), 7 nights, ICU certification
; held by alice/bob/cara only. Rows: variable domains, nightly certified
; coverage, the consecutive-night rest rule, weekly caps, a minimum-hours
; floor, and five fixed pre-assignments (leave, training, handover duty).
;
; The infeasibility is NOT a global staff-hours shortage -- certified
; capacity is 9 night-shifts against a requirement of 7. It is local to
; night 4 and involves five rows; the other 97 are jointly satisfiable.

(set-logic QF_LIA)
(set-option :produce-unsat-cores true)

(declare-fun x_alice_1 () Int)
(declare-fun x_alice_2 () Int)
(declare-fun x_alice_3 () Int)
(declare-fun x_alice_4 () Int)
(declare-fun x_alice_5 () Int)
(declare-fun x_alice_6 () Int)
(declare-fun x_alice_7 () Int)
(declare-fun x_bob_1 () Int)
(declare-fun x_bob_2 () Int)
(declare-fun x_bob_3 () Int)
(declare-fun x_bob_4 () Int)
(declare-fun x_bob_5 () Int)
(declare-fun x_bob_6 () Int)
(declare-fun x_bob_7 () Int)
(declare-fun x_cara_1 () Int)
(declare-fun x_cara_2 () Int)
(declare-fun x_cara_3 () Int)
(declare-fun x_cara_4 () Int)
(declare-fun x_cara_5 () Int)
(declare-fun x_cara_6 () Int)
(declare-fun x_cara_7 () Int)
(declare-fun x_dev_1 () Int)
(declare-fun x_dev_2 () Int)
(declare-fun x_dev_3 () Int)
(declare-fun x_dev_4 () Int)
(declare-fun x_dev_5 () Int)
(declare-fun x_dev_6 () Int)
(declare-fun x_dev_7 () Int)
(declare-fun x_eli_1 () Int)
(declare-fun x_eli_2 () Int)
(declare-fun x_eli_3 () Int)
(declare-fun x_eli_4 () Int)
(declare-fun x_eli_5 () Int)
(declare-fun x_eli_6 () Int)
(declare-fun x_eli_7 () Int)
(declare-fun x_fern_1 () Int)
(declare-fun x_fern_2 () Int)
(declare-fun x_fern_3 () Int)
(declare-fun x_fern_4 () Int)
(declare-fun x_fern_5 () Int)
(declare-fun x_fern_6 () Int)
(declare-fun x_fern_7 () Int)

; -- variable domains: a nurse either works a night or does not
(assert (! (and (>= x_alice_1 0) (<= x_alice_1 1)) :named dom_alice_1))
(assert (! (and (>= x_alice_2 0) (<= x_alice_2 1)) :named dom_alice_2))
(assert (! (and (>= x_alice_3 0) (<= x_alice_3 1)) :named dom_alice_3))
(assert (! (and (>= x_alice_4 0) (<= x_alice_4 1)) :named dom_alice_4))
(assert (! (and (>= x_alice_5 0) (<= x_alice_5 1)) :named dom_alice_5))
(assert (! (and (>= x_alice_6 0) (<= x_alice_6 1)) :named dom_alice_6))
(assert (! (and (>= x_alice_7 0) (<= x_alice_7 1)) :named dom_alice_7))
(assert (! (and (>= x_bob_1 0) (<= x_bob_1 1)) :named dom_bob_1))
(assert (! (and (>= x_bob_2 0) (<= x_bob_2 1)) :named dom_bob_2))
(assert (! (and (>= x_bob_3 0) (<= x_bob_3 1)) :named dom_bob_3))
(assert (! (and (>= x_bob_4 0) (<= x_bob_4 1)) :named dom_bob_4))
(assert (! (and (>= x_bob_5 0) (<= x_bob_5 1)) :named dom_bob_5))
(assert (! (and (>= x_bob_6 0) (<= x_bob_6 1)) :named dom_bob_6))
(assert (! (and (>= x_bob_7 0) (<= x_bob_7 1)) :named dom_bob_7))
(assert (! (and (>= x_cara_1 0) (<= x_cara_1 1)) :named dom_cara_1))
(assert (! (and (>= x_cara_2 0) (<= x_cara_2 1)) :named dom_cara_2))
(assert (! (and (>= x_cara_3 0) (<= x_cara_3 1)) :named dom_cara_3))
(assert (! (and (>= x_cara_4 0) (<= x_cara_4 1)) :named dom_cara_4))
(assert (! (and (>= x_cara_5 0) (<= x_cara_5 1)) :named dom_cara_5))
(assert (! (and (>= x_cara_6 0) (<= x_cara_6 1)) :named dom_cara_6))
(assert (! (and (>= x_cara_7 0) (<= x_cara_7 1)) :named dom_cara_7))
(assert (! (and (>= x_dev_1 0) (<= x_dev_1 1)) :named dom_dev_1))
(assert (! (and (>= x_dev_2 0) (<= x_dev_2 1)) :named dom_dev_2))
(assert (! (and (>= x_dev_3 0) (<= x_dev_3 1)) :named dom_dev_3))
(assert (! (and (>= x_dev_4 0) (<= x_dev_4 1)) :named dom_dev_4))
(assert (! (and (>= x_dev_5 0) (<= x_dev_5 1)) :named dom_dev_5))
(assert (! (and (>= x_dev_6 0) (<= x_dev_6 1)) :named dom_dev_6))
(assert (! (and (>= x_dev_7 0) (<= x_dev_7 1)) :named dom_dev_7))
(assert (! (and (>= x_eli_1 0) (<= x_eli_1 1)) :named dom_eli_1))
(assert (! (and (>= x_eli_2 0) (<= x_eli_2 1)) :named dom_eli_2))
(assert (! (and (>= x_eli_3 0) (<= x_eli_3 1)) :named dom_eli_3))
(assert (! (and (>= x_eli_4 0) (<= x_eli_4 1)) :named dom_eli_4))
(assert (! (and (>= x_eli_5 0) (<= x_eli_5 1)) :named dom_eli_5))
(assert (! (and (>= x_eli_6 0) (<= x_eli_6 1)) :named dom_eli_6))
(assert (! (and (>= x_eli_7 0) (<= x_eli_7 1)) :named dom_eli_7))
(assert (! (and (>= x_fern_1 0) (<= x_fern_1 1)) :named dom_fern_1))
(assert (! (and (>= x_fern_2 0) (<= x_fern_2 1)) :named dom_fern_2))
(assert (! (and (>= x_fern_3 0) (<= x_fern_3 1)) :named dom_fern_3))
(assert (! (and (>= x_fern_4 0) (<= x_fern_4 1)) :named dom_fern_4))
(assert (! (and (>= x_fern_5 0) (<= x_fern_5 1)) :named dom_fern_5))
(assert (! (and (>= x_fern_6 0) (<= x_fern_6 1)) :named dom_fern_6))
(assert (! (and (>= x_fern_7 0) (<= x_fern_7 1)) :named dom_fern_7))

; -- coverage: at least one ICU-certified nurse on every night
(assert (! (>= (+ x_alice_1 x_bob_1 x_cara_1) 1) :named cov_night1))
(assert (! (>= (+ x_alice_2 x_bob_2 x_cara_2) 1) :named cov_night2))
(assert (! (>= (+ x_alice_3 x_bob_3 x_cara_3) 1) :named cov_night3))
(assert (! (>= (+ x_alice_4 x_bob_4 x_cara_4) 1) :named cov_night4))
(assert (! (>= (+ x_alice_5 x_bob_5 x_cara_5) 1) :named cov_night5))
(assert (! (>= (+ x_alice_6 x_bob_6 x_cara_6) 1) :named cov_night6))
(assert (! (>= (+ x_alice_7 x_bob_7 x_cara_7) 1) :named cov_night7))

; -- rest rule: no nurse works two consecutive nights
(assert (! (<= (+ x_alice_1 x_alice_2) 1) :named rest_alice_n1n2))
(assert (! (<= (+ x_alice_2 x_alice_3) 1) :named rest_alice_n2n3))
(assert (! (<= (+ x_alice_3 x_alice_4) 1) :named rest_alice_n3n4))
(assert (! (<= (+ x_alice_4 x_alice_5) 1) :named rest_alice_n4n5))
(assert (! (<= (+ x_alice_5 x_alice_6) 1) :named rest_alice_n5n6))
(assert (! (<= (+ x_alice_6 x_alice_7) 1) :named rest_alice_n6n7))
(assert (! (<= (+ x_bob_1 x_bob_2) 1) :named rest_bob_n1n2))
(assert (! (<= (+ x_bob_2 x_bob_3) 1) :named rest_bob_n2n3))
(assert (! (<= (+ x_bob_3 x_bob_4) 1) :named rest_bob_n3n4))
(assert (! (<= (+ x_bob_4 x_bob_5) 1) :named rest_bob_n4n5))
(assert (! (<= (+ x_bob_5 x_bob_6) 1) :named rest_bob_n5n6))
(assert (! (<= (+ x_bob_6 x_bob_7) 1) :named rest_bob_n6n7))
(assert (! (<= (+ x_cara_1 x_cara_2) 1) :named rest_cara_n1n2))
(assert (! (<= (+ x_cara_2 x_cara_3) 1) :named rest_cara_n2n3))
(assert (! (<= (+ x_cara_3 x_cara_4) 1) :named rest_cara_n3n4))
(assert (! (<= (+ x_cara_4 x_cara_5) 1) :named rest_cara_n4n5))
(assert (! (<= (+ x_cara_5 x_cara_6) 1) :named rest_cara_n5n6))
(assert (! (<= (+ x_cara_6 x_cara_7) 1) :named rest_cara_n6n7))
(assert (! (<= (+ x_dev_1 x_dev_2) 1) :named rest_dev_n1n2))
(assert (! (<= (+ x_dev_2 x_dev_3) 1) :named rest_dev_n2n3))
(assert (! (<= (+ x_dev_3 x_dev_4) 1) :named rest_dev_n3n4))
(assert (! (<= (+ x_dev_4 x_dev_5) 1) :named rest_dev_n4n5))
(assert (! (<= (+ x_dev_5 x_dev_6) 1) :named rest_dev_n5n6))
(assert (! (<= (+ x_dev_6 x_dev_7) 1) :named rest_dev_n6n7))
(assert (! (<= (+ x_eli_1 x_eli_2) 1) :named rest_eli_n1n2))
(assert (! (<= (+ x_eli_2 x_eli_3) 1) :named rest_eli_n2n3))
(assert (! (<= (+ x_eli_3 x_eli_4) 1) :named rest_eli_n3n4))
(assert (! (<= (+ x_eli_4 x_eli_5) 1) :named rest_eli_n4n5))
(assert (! (<= (+ x_eli_5 x_eli_6) 1) :named rest_eli_n5n6))
(assert (! (<= (+ x_eli_6 x_eli_7) 1) :named rest_eli_n6n7))
(assert (! (<= (+ x_fern_1 x_fern_2) 1) :named rest_fern_n1n2))
(assert (! (<= (+ x_fern_2 x_fern_3) 1) :named rest_fern_n2n3))
(assert (! (<= (+ x_fern_3 x_fern_4) 1) :named rest_fern_n3n4))
(assert (! (<= (+ x_fern_4 x_fern_5) 1) :named rest_fern_n4n5))
(assert (! (<= (+ x_fern_5 x_fern_6) 1) :named rest_fern_n5n6))
(assert (! (<= (+ x_fern_6 x_fern_7) 1) :named rest_fern_n6n7))

; -- weekly cap: at most three night shifts per nurse
(assert (! (<= (+ x_alice_1 x_alice_2 x_alice_3 x_alice_4 x_alice_5 x_alice_6 x_alice_7) 3) :named cap_alice))
(assert (! (<= (+ x_bob_1 x_bob_2 x_bob_3 x_bob_4 x_bob_5 x_bob_6 x_bob_7) 3) :named cap_bob))
(assert (! (<= (+ x_cara_1 x_cara_2 x_cara_3 x_cara_4 x_cara_5 x_cara_6 x_cara_7) 3) :named cap_cara))
(assert (! (<= (+ x_dev_1 x_dev_2 x_dev_3 x_dev_4 x_dev_5 x_dev_6 x_dev_7) 3) :named cap_dev))
(assert (! (<= (+ x_eli_1 x_eli_2 x_eli_3 x_eli_4 x_eli_5 x_eli_6 x_eli_7) 3) :named cap_eli))
(assert (! (<= (+ x_fern_1 x_fern_2 x_fern_3 x_fern_4 x_fern_5 x_fern_6 x_fern_7) 3) :named cap_fern))

; -- minimum hours floor: every nurse works at least one night
(assert (! (>= (+ x_alice_1 x_alice_2 x_alice_3 x_alice_4 x_alice_5 x_alice_6 x_alice_7) 1) :named minhours_alice))
(assert (! (>= (+ x_bob_1 x_bob_2 x_bob_3 x_bob_4 x_bob_5 x_bob_6 x_bob_7) 1) :named minhours_bob))
(assert (! (>= (+ x_cara_1 x_cara_2 x_cara_3 x_cara_4 x_cara_5 x_cara_6 x_cara_7) 1) :named minhours_cara))
(assert (! (>= (+ x_dev_1 x_dev_2 x_dev_3 x_dev_4 x_dev_5 x_dev_6 x_dev_7) 1) :named minhours_dev))
(assert (! (>= (+ x_eli_1 x_eli_2 x_eli_3 x_eli_4 x_eli_5 x_eli_6 x_eli_7) 1) :named minhours_eli))
(assert (! (>= (+ x_fern_1 x_fern_2 x_fern_3 x_fern_4 x_fern_5 x_fern_6 x_fern_7) 1) :named minhours_fern))

; -- fixed pre-assignments
(assert (! (= x_alice_4 0) :named leave_alice_night4))  ; annual leave, approved
(assert (! (= x_cara_4 0) :named training_cara_night4))  ; ICU recertification
(assert (! (= x_bob_3 1) :named handover_bob_night3))  ; midweek handover duty
(assert (! (= x_dev_1 0) :named leave_dev_night1))
(assert (! (= x_eli_7 0) :named leave_eli_night7))

(check-sat)
(get-unsat-core)
(exit)

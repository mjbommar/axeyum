{
  "schema_version": 1,
  "kind": "axeyum-autogenesis-knowledge-overlay",
  "sources": [
    {
      "id": "axeyum",
      "kind": "local-repository",
      "revision_policy": "live-worktree",
      "path_hint": "."
    }
  ],
  "namespaces": [
    {
      "id": "axeyum-knowledge",
      "source_id": "axeyum",
      "entity_kinds": ["capability", "obstruction", "episode", "representation", "concept"],
      "resolution": "overlay-entity",
      "path": "artifacts/autogenesis/knowledge-overlay-v1.json"
    },
    {
      "id": "axeyum-fact",
      "source_id": "axeyum",
      "entity_kinds": ["fact"],
      "resolution": "local-required",
      "path": "artifacts/facts",
      "id_pattern": "^F:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    {
      "id": "axeyum-operation",
      "source_id": "axeyum",
      "entity_kinds": ["operation"],
      "resolution": "local-required",
      "path": "artifacts/autogenesis/operations.json"
    },
    {
      "id": "axeyum-kernel",
      "source_id": "axeyum",
      "entity_kinds": ["kernel-declaration"],
      "resolution": "local-required",
      "path": "artifacts/autogenesis/kernel-dependency-projection-v1.json",
      "notes": "Generated kernel-observed declaration projection. Direct theorem edges remain separate from fact-ledger planning dependencies."
    }
  ],
  "relation_types": [
    {
      "id": "realizes-capability",
      "source_kinds": ["operation"],
      "target_kinds": ["capability"],
      "semantics": "The registered operation is an executable realization of the reusable capability."
    },
    {
      "id": "established-by",
      "source_kinds": ["fact"],
      "target_kinds": ["operation"],
      "semantics": "The authoritative fact transition is credited to this registered operation."
    },
    {
      "id": "direct-theorem-depends-on",
      "source_kinds": ["kernel-declaration"],
      "target_kinds": ["kernel-declaration"],
      "semantics": "A direct theorem reference read from an accepted kernel theorem term. This is neither a transitive closure nor a fact-ledger planning dependency."
    },
    {
      "id": "blocked-by",
      "source_kinds": ["fact", "operation", "capability"],
      "target_kinds": ["obstruction", "capability", "fact", "kernel-declaration"],
      "semantics": "The source cannot currently advance without resolving the target under the stated qualifiers."
    },
    {
      "id": "unlocks",
      "source_kinds": ["fact", "capability"],
      "target_kinds": ["fact", "capability"],
      "semantics": "Establishing the source makes the target newly reachable or measurably cheaper; readiness and solution are distinct."
    },
    {
      "id": "definitionally-matches",
      "source_kinds": ["fact"],
      "target_kinds": ["kernel-declaration"],
      "semantics": "An independently checked cross-kernel translation found the fact's proof-free proposition definitionally equal to the kernel declaration's theorem type. This diagnostic link neither settles the fact nor grants proof, operation, or admission authority."
    },
    {
      "id": "formalizes",
      "source_kinds": ["fact", "kernel-declaration"],
      "target_kinds": ["concept"],
      "semantics": "A checked fact or empty-footprint kernel theorem supplies the qualified formal content named by an Axeyum-owned concept. The human-reviewed edge is partial semantic metadata and grants no proof, admission, or operation authority.",
      "reason_required": true
    }
  ],
  "entities": [
    {
      "id": "K:bounded-structural-induction",
      "kind": "capability",
      "title": "Bounded structural induction producer",
      "description": "Discovers a zero/successor inductive shape and constructs a bounded induction proof with congruence rewriting, without target-name dispatch.",
      "status": "active",
      "attributes": {
        "max_binders": 8,
        "max_inductions": 2,
        "assurance_floor": "kernel-lean-empty-axiom-footprint"
      }
    },
    {
      "id": "K:modeq-equivalence-combinators",
      "kind": "capability",
      "title": "Definitional equivalence-relation combinator producer",
      "description": "Unfolds a transparent relation and constructs reflexive, symmetric, transitive, and commutative equivalence proofs from primitive equality and iff eliminators.",
      "status": "active",
      "attributes": {
        "max_binders": 8,
        "assurance_floor": "kernel-lean-empty-axiom-footprint",
        "blind_development_result": "4/4 Nat.ModEq siblings closed without changing the producer"
      }
    },
    {
      "id": "K:declaration-or-inductive-import",
      "kind": "capability",
      "title": "Checked declaration or inductive-package import",
      "description": "Candidate capability to select, transport, and independently check one demanded target-owned declaration or atomic inductive package, with exact identity and footprint controls. It is not an implemented import operation.",
      "status": "candidate",
      "attributes": {
        "evidence_basis": "repeated retained MissingTargetOwnedDefinition and unsupported-missing-declaration declines",
        "assurance_floor": "kernel-lean-empty-axiom-footprint",
        "admission_authority": false
      }
    },
    {
      "id": "K:typed-transport-composition",
      "kind": "capability",
      "title": "Typed transport and composition",
      "description": "Candidate capability to compose checked declarations across compatible dependent type shapes while retaining exact source/target identities. It is not a license to name-match or erase a type mismatch.",
      "status": "candidate",
      "attributes": {
        "evidence_basis": "retained TypeShapeMismatch and decision-witness-dependent type-shape declines",
        "assurance_floor": "kernel-checked-transport-receipt",
        "admission_authority": false
      }
    },
    {
      "id": "K:bounded-reproducible-export",
      "kind": "capability",
      "title": "Bounded reproducible export environment",
      "description": "Candidate capability to stage and replay a proof-isolated export with fixed module roots, search paths, and resource bounds. It is environment reproducibility support, not proof construction.",
      "status": "candidate",
      "attributes": {
        "evidence_basis": "retained exporter/module/root/resource decline records",
        "assurance_floor": "byte-identical-export-and-fresh-import",
        "admission_authority": false
      }
    },
    {
      "id": "K:checked-declaration-reuse",
      "kind": "capability",
      "title": "Checked declaration reuse",
      "description": "Candidate capability to reuse a previously checked target-owned declaration only through an exact dependency contract and fresh kernel check. It does not permit source-proof leakage or undeclared dependency grafting.",
      "status": "candidate",
      "attributes": {
        "evidence_basis": "retained NoAdditions and official-composition declines",
        "assurance_floor": "exact-dependency-contract-and-fresh-kernel-check",
        "admission_authority": false
      }
    },
    {
      "id": "C:excluded-middle",
      "kind": "concept",
      "title": "Excluded middle",
      "description": "The proposition schema p or not-p. A theorem requiring an explicit Decidable p witness covers the decidable instance only, not unrestricted classical excluded middle.",
      "status": "active",
      "attributes": {
        "definition_scope": "local-self-contained",
        "scheduler_authority": false
      }
    },
    {
      "id": "C:complex-number",
      "kind": "concept",
      "title": "Complex numbers",
      "description": "Numbers with real and imaginary components together with their algebraic operations and norm laws. One identity about squared norm is supporting content, not complete complex analysis.",
      "status": "active",
      "attributes": {
        "definition_scope": "local-self-contained",
        "scheduler_authority": false
      }
    },
    {
      "id": "C:circle",
      "kind": "concept",
      "title": "Circle geometry",
      "description": "Geometry of points at equal distance from a centre, including circumcircles of non-collinear triples. A circumcentre uniqueness theorem covers one defining construction only.",
      "status": "active",
      "attributes": {
        "definition_scope": "local-self-contained",
        "scheduler_authority": false
      }
    }
  ],

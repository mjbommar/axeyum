    "induction_binder": "n",
    "base": "reduce fib 0 and fib 1, then apply Nat.gcd_zero_left",
    "step": [
      "rewrite fib (n + 2) with the admitted Nat.fib_add_two theorem",
      "let d = gcd (fib (n + 1)) (fib n + fib (n + 1))",

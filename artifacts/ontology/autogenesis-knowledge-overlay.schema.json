{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axeyum.dev/ontology/autogenesis-knowledge-overlay.schema.json",
  "title": "Axeyum Autogenesis Knowledge Overlay",
  "description": "An additive, versioned property-graph overlay joining existing Axeyum entities and a self-contained local concept vocabulary without changing their owning schemas. Edges are qualified claims: their assurance and provenance are first-class and never inferred from relation names. No endpoint resolves outside this checkout.",
  "type": "object",
  "required": ["schema_version", "kind", "sources", "namespaces", "relation_types", "entities", "links"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "axeyum-autogenesis-knowledge-overlay" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "namespaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/namespace" }
    },
    "relation_types": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationType" }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "links": {
      "type": "array",
      "items": { "$ref": "#/$defs/link" }
    }
  },
  "$defs": {
    "entityKind": {
      "description": "Every kind here must be supplied by some local namespace. `concept` is an Axeyum-owned, self-contained vocabulary entry; it may be adapted from reference material but cannot resolve against a sibling repository. Encounter, technique, curriculum-node, and external-declaration remain excluded.",
      "enum": [
        "fact", "kernel-declaration", "operation", "producer",
        "checker", "capability", "obstruction", "episode", "evidence-artifact",
        "representation", "concept"
      ]
    },
    "source": {
      "type": "object",
      "required": ["id", "kind", "revision_policy"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "kind": {
          "description": "Local only. ADR-0553 forbids this overlay from declaring an external repository or artifact.",
          "enum": ["local-repository", "local-artifact"]
        },
        "revision_policy": { "enum": ["live-worktree", "pinned"] },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path_hint": {
          "description": "A path INSIDE this checkout. `..` segments and absolute paths are refused (ADR-0553): a path that escapes the checkout is a dependency on something this repository does not own.",
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "license_note": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "revision_policy": { "const": "pinned" } } },
          "then": { "required": ["revision"] }
        }
      ]
    },
    "namespace": {
      "type": "object",
      "required": ["id", "source_id", "entity_kinds", "resolution"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "source_id": { "type": "string" },
        "entity_kinds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/entityKind" }
        },
        "resolution": {
          "description": "Local only. `external-pinned` was removed by ADR-0553.",
          "enum": ["overlay-entity", "local-required"]
        },
        "path": { "type": "string", "minLength": 1 },
        "id_pattern": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "endpoint": {
      "type": "object",
      "required": ["namespace", "kind", "id"],
      "additionalProperties": false,
      "properties": {
        "namespace": { "type": "string" },
        "kind": { "$ref": "#/$defs/entityKind" },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "relationType": {
      "type": "object",
      "required": ["id", "source_kinds", "target_kinds", "semantics"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "source_kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/entityKind" } },
        "target_kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/entityKind" } },
        "semantics": { "type": "string", "minLength": 1 },
        "inverse": { "type": "string" },
        "reason_required": { "type": "boolean" }
      }
    },
    "entity": {
      "type": "object",
      "required": ["id", "kind", "title", "description", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(?:K|C):[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "$ref": "#/$defs/entityKind" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "candidate", "deprecated"] },
        "attributes": { "type": "object" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["method", "sources"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["kernel-derived", "checker-derived", "registry-derived", "mechanically-observed", "human-reviewed", "heuristic", "proposed"] },
        "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "notes": { "type": "string" }
      }
    },
    "link": {
      "type": "object",
      "required": ["id", "relation", "source", "target", "assurance", "status", "reason", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^L:[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "relation": { "type": "string" },
        "source": { "$ref": "#/$defs/endpoint" },
        "target": { "$ref": "#/$defs/endpoint" },
        "assurance": { "enum": ["formal-derived", "independently-checked", "registry-derived", "mechanically-observed", "human-reviewed", "heuristic", "proposed"] },
        "status": { "enum": ["active", "candidate", "deprecated"] },
        "reason": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" },
        "qualifiers": { "type": "object" },
        "evidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}

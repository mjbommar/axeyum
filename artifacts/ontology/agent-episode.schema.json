{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axeyum.dev/ontology/agent-episode.schema.json",
  "title": "Axeyum Agent Episode",
  "description": "One run of the agentic frontier loop, recorded so that its verdict can be re-derived rather than believed. An episode carries NO admission authority: `outcome.ledger_writes` is pinned to 0 by this schema and again by scripts/check-agent-episode.py, and `proposals[].assurance` is pinned to \"proposed\". The spine (toolchain-style pins, content-addressed external artifacts, an explicit reproduction command) is copied from the statement-adapter manifests, and four outcome field names are lifted verbatim from scripts/execute-autogenesis-operation.py's receipt builder so an episode diffs against a receipt.",
  "type": "object",
  "required": [
    "schema_version", "kind", "episode_id", "git_commit", "created_at",
    "selection", "policy", "budgets", "transcript", "web_snapshots",
    "proposals", "outcome", "observed"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "axeyum-agent-episode" },
    "episode_id": { "type": "string", "pattern": "^E:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "selection": { "$ref": "#/$defs/selection" },
    "policy": { "$ref": "#/$defs/policy" },
    "budgets": { "$ref": "#/$defs/budgets" },
    "transcript": { "$ref": "#/$defs/transcript" },
    "web_snapshots": { "type": "array", "items": { "$ref": "#/$defs/webSnapshot" } },
    "proposals": { "type": "array", "items": { "$ref": "#/$defs/proposal" } },
    "outcome": { "$ref": "#/$defs/outcome" },
    "observed": { "$ref": "#/$defs/observed" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "factId": { "type": "string", "pattern": "^F:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "selection": {
      "description": "What the loop chose and why. `partition` admits train and development ONLY: held-out is not expressible here, so an episode cannot even claim to have looked at a blind row. The generic string walk in scripts/check-agent-episode.py enforces the same thing everywhere else in the document, because a field-specific guard is bypassable the day it is written.",
      "type": "object",
      "required": ["frontier_sha256", "frontier_path", "fact_id", "fact_sha256", "partition", "eligibility_reason"],
      "additionalProperties": false,
      "properties": {
        "frontier_sha256": { "$ref": "#/$defs/sha256" },
        "frontier_path": { "type": "string", "minLength": 1 },
        "fact_id": { "$ref": "#/$defs/factId" },
        "fact_sha256": { "$ref": "#/$defs/sha256" },
        "partition": { "enum": ["train", "development"] },
        "eligibility_reason": { "type": "string", "minLength": 1 }
      }
    },
    "policy": {
      "description": "Everything that would have to be identical for a replay to be meaningful. `model_id` is provider-prefixed and exact; `settings` are the sampling knobs; the three digests pin the prompts, the toolset and the agent code.",
      "type": "object",
      "required": ["model_id", "settings", "prompt_hashes", "toolset_sha256", "agent_code_sha256", "library_versions"],
      "additionalProperties": false,
      "properties": {
        "model_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*:[A-Za-z0-9._-]+$" },
        "settings": { "$ref": "#/$defs/settings" },
        "prompt_hashes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/sha256" } },
        "toolset_sha256": { "$ref": "#/$defs/sha256" },
        "agent_code_sha256": { "$ref": "#/$defs/sha256" },
        "library_versions": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    },
    "settings": {
      "type": "object",
      "required": ["temperature", "top_p", "max_tokens", "seed"],
      "additionalProperties": false,
      "properties": {
        "temperature": { "type": "number", "minimum": 0 },
        "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "seed": { "type": ["integer", "null"] }
      }
    },
    "budgets": {
      "description": "Budget exhaustion is a VERDICT, not an error (plan 03), so the limits are recorded even when they were not reached.",
      "type": "object",
      "required": ["wall_seconds", "request_limit", "tool_calls_limit", "input_tokens_limit", "output_tokens_limit", "cost_limit_usd"],
      "additionalProperties": false,
      "properties": {
        "wall_seconds": { "type": "integer", "minimum": 1 },
        "request_limit": { "type": "integer", "minimum": 1 },
        "tool_calls_limit": { "type": "integer", "minimum": 1 },
        "input_tokens_limit": { "type": "integer", "minimum": 1 },
        "output_tokens_limit": { "type": "integer", "minimum": 1 },
        "cost_limit_usd": { "type": "number", "minimum": 0 }
      }
    },
    "transcript": {
      "description": "`tool_calls` is a PROJECTION of the serialized message list, not a parallel log: it is derived from the same objects `messages_sha256` covers, so the two cannot silently disagree. There is deliberately no `minItems` here -- the empty-transcript rule lives in the checker, where its guard can be deleted and a test required to die.",
      "type": "object",
      "required": ["messages_sha256", "messages_path", "tool_calls"],
      "additionalProperties": false,
      "properties": {
        "messages_sha256": { "$ref": "#/$defs/sha256" },
        "messages_path": { "type": "string", "minLength": 1 },
        "tool_calls": { "type": "array", "items": { "$ref": "#/$defs/toolCall" } }
      }
    },
    "toolCall": {
      "type": "object",
      "required": ["ordinal", "tool", "args_sha256", "result_sha256", "assurance", "duration_ms", "exit_status"],
      "additionalProperties": false,
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "tool": { "type": "string", "minLength": 1 },
        "args_sha256": { "$ref": "#/$defs/sha256" },
        "result_sha256": { "$ref": "#/$defs/sha256" },
        "assurance": { "enum": ["read", "proposed", "checked"] },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "exit_status": { "type": "integer" }
      }
    },
    "webSnapshot": {
      "description": "A fetched page is admitted as bytes on disk with a digest, never as a summary. The checker re-hashes `path` and fails on a mismatch or a missing file.",
      "type": "object",
      "required": ["url", "fetched_at", "sha256", "bytes", "path"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "fetched_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "proposal": {
      "description": "`assurance` is const \"proposed\" and there is no other value: a P-tier tool cannot emit anything that reads as checked.",
      "type": "object",
      "required": ["path", "sha256", "kind", "assurance"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "kind": { "enum": ["strategy", "lemma", "overlay-link"] },
        "assurance": { "const": "proposed" }
      }
    },
    "outcome": {
      "description": "`ledger_writes`, `search_invocations` and `target_theorem_submissions` are the receipt field names from scripts/execute-autogenesis-operation.py, reused verbatim. `checker_command` carries no minLength on purpose: \"proved with an empty checker command\" is a checker rule, so that guard is deletable and a test dies when it is.",
      "type": "object",
      "required": ["verdict", "decline_class", "checker_command", "checker_exit_status", "checker_output_sha256", "axiom_footprint", "ledger_writes", "search_invocations", "target_theorem_submissions"],
      "additionalProperties": false,
      "properties": {
        "verdict": { "enum": ["proved", "declined", "error", "budget-exhausted"] },
        "decline_class": { "type": ["string", "null"] },
        "checker_command": { "type": "string" },
        "checker_exit_status": { "type": "integer" },
        "checker_output_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "axiom_footprint": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "ledger_writes": { "type": "integer", "minimum": 0, "maximum": 0 },
        "search_invocations": { "type": "integer", "minimum": 0 },
        "target_theorem_submissions": { "type": "integer", "minimum": 0 }
      }
    },
    "observed": {
      "description": "What the episode OBSERVED about the world, as distinct from what it claims. Every entry here is a pointer into an authority that a separate gate re-derives; nothing here is itself evidence.",
      "type": "object",
      "required": ["facts_unlocked", "operations_widened", "overlay_links_proposed"],
      "additionalProperties": false,
      "properties": {
        "facts_unlocked": { "type": "array", "items": { "$ref": "#/$defs/factId" } },
        "operations_widened": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "overlay_links_proposed": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}

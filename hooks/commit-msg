#!/usr/bin/env bash
# Stamp every commit with the lane that made it.
#
# Every commit in this checkout carries the SAME git author, because several
# agent lanes and a human share one identity. So `git log` cannot answer "who
# did this", and on 2026-08-14 three separate parties misattributed commits to
# the wrong lane within one day — twice by the coordinator, once by a peer —
# while one lane's PLAN.md edit was swept into another's commit with no way to
# tell afterwards.
#
# This hook APPENDS a trailer rather than rejecting, deliberately. The pre-push
# hook's own history records why: a gate that forces `--no-verify` defeats
# itself. So identify your lane,
#
#     export AXEYUM_AGENT=<lane-id>            # e.g. coordinator, lean-kernel
#
# and every commit from that shell is stamped.
#
# THE ENV VAR IS PRIMARY, and that ordering is the whole point. The first
# version of this hook read `git config axeyum.agent` only — repo-LOCAL config,
# which in a checkout shared by several lanes is one more shared append point.
# It took 5 minutes to bite: the `gates` lane set it, and the coordinator's very
# next commit (c8bd277f9) was stamped `gates`. A hook written to stop
# misattribution had misattributed a commit to the wrong lane. Environment is
# per-process, so it is the only identity that can differ between two lanes
# working in one tree. `git config` remains as a fallback for the ordinary
# single-lane checkout, where it is genuinely more convenient.
#
# Install (per checkout): git config core.hooksPath hooks
set -euo pipefail

msg_file="$1"

# Merges, squashes, fixups and reverts are mechanical — git composes their
# messages and a lane stamp on them says nothing useful.
head -1 "$msg_file" | grep -qiE '^(merge|revert|fixup!|squash!|amend!)' && exit 0

# Already stamped (including by a template or a previous --amend): leave it.
grep -qiE '^Agent:[[:space:]]*\S' "$msg_file" && exit 0

# Per-process first, repo-local second. See the note above: the reverse order
# stamped a coordinator commit with another lane's name within 5 minutes.
agent="${AXEYUM_AGENT:-$(git config --get axeyum.agent 2>/dev/null || true)}"

if [[ -z "$agent" ]]; then
    cat >&2 <<'EOF'
commit-msg: this shell has no lane identity, so the commit cannot be attributed.

  export AXEYUM_AGENT=<lane-id>

Pick anything stable that names who is working here — `coordinator`,
`lean-kernel`, `alice`.

If this checkout only ever has ONE writer, `git config axeyum.agent <lane-id>`
is a persistent equivalent. Do NOT use it in a checkout several lanes share:
that config is repo-local, so whoever sets it last renames everyone else. It
happened to this hook's own author (c8bd277f9), which is why the env var wins.

Why any of this: several lanes and a human share one git author here, so
`git log` cannot say who made a change. Three parties misattributed commits on
2026-08-14.
EOF
    exit 1
fi

# Append via git's OWN trailer parser, not by hand.
#
# The hand-rolled version appended `Agent: <lane>` after deciding whether a
# blank line was needed by testing `tail -1` against `^[A-Za-z-]+:[[:space:]]`.
# That test cannot tell a trailer from a sentence, and it produced commits
# carrying the TEXT of a trailer that git does not PARSE as one -- so
# `git log --format='%(trailers:key=Agent,valueonly)'`, the query CLAUDE.md
# prescribes for pairing a commit with its lane, reads them as unattributed.
#
# Measured 2026-08-25 over the last 60 commits: 46 parsed, 12 had no stamp at
# all (`--no-verify` merges), and 2 had the text without parsing. Both failures
# were the same misreading:
#
#   - a body whose last line was prose beginning `ways: the true value ...`
#     -- `ways:` matches the pattern, so no blank line was inserted and the
#     line joined the preceding paragraph;
#   - a SUBJECT-ONLY message, `fixup: clippy ...` -- `fixup:` matches too, so
#     the trailer was glued directly under the subject with no blank line, and
#     a two-line message has no trailer block at all.
#
# `git interpret-trailers` gets all three shapes right, including appending
# into an existing trailer block without an extra blank line. Controls, one per
# shape: scripts/tests/test-commit-msg-trailer.sh.
git interpret-trailers --trailer "Agent: $agent" --in-place "$msg_file"
exit 0

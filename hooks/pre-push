#!/usr/bin/env bash
# Fail-closed pre-push gate (5th periodic review: mechanism over vigilance).
#
# Catches the class of failure that reached main on 2026-07-03: a pushed SHA
# that does not COMPILE (a shared-index sweep published a re-export one commit
# before its definition — 5ad952b8), and formatting drift.
#
# This is a HEAVY gate, and as of 2026-08-16 that is a deliberate choice rather
# than a drift — but this comment claimed the opposite ("deliberately fast
# (~seconds hot)", "the heavy gates stay in CI") long after the hook had
# acquired the workspace unit sweep, the solver `--lib` sweep, the capability
# frontier ratchet and ten integration suites. Pushes touching no Rust/TOML
# still skip the cargo steps entirely; everything else pays the full battery.
# Measured warm on s4:
#
#   cargo check --workspace          0s     (free once the cache is warm)
#   cargo fmt --all --check          3s
#   clippy --workspace (all targets) 1s warm (759 targets; cold pays a full
#                                     workspace clippy build — added 2026-08-31,
#                                     see the step's own comment)
#   corpus :status sweep            13s
#   cargo test --workspace --lib   224s
#   solver unit sweep (full)        31s   (1008 tests; --skip reconstruct::)
#   [moved to `just check`]        294s   (268 reconstruct:: tests, Lean preludes)
#   capability frontier ratchet    216s
#   integration suites x4           ~1s
#   evidence suite                  70s
#   ---------------------------------------
#   total                          557s
#
# Every one of those was added because something reached `main`. The per-step
# seconds are printed on every run so the cost stays visible and future growth
# is a decision rather than a drift.
#
# Gates the PUSHED COMMIT, not the working tree. The old hook ran `cargo check`
# over the working tree, so an unrelated agent's uncommitted WIP (a shared
# checkout always has some) failed the gate for a perfectly good pushed SHA —
# forcing a `--no-verify` that defeats the whole mechanism (happened 2026-07-06).
# We instead check out the exact pushed SHA into a **detached worktree** (never
# `git stash`, which would clobber a sibling lane's WIP) and run the gate there,
# against a persistent `CARGO_TARGET_DIR` that keeps it warm (~seconds hot).
#
# That last claim was FALSE for as long as the worktree came from `mktemp -d`.
# Cargo bakes absolute paths into its fingerprints, so a fresh random path per
# push invalidated every unit and the "warm" cache rebuilt the whole 236k-line
# workspace cold, EVERY TIME -- ~10 minutes a push. Measured 2026-08-16: three
# distinct `/tmp/axeyum-prepush.XXXXXX` paths were baked into one 14 GB shared
# cache. The comment on CARGO_TARGET_DIR below had already identified the
# mechanism (it is why the gate got its own target dir) without noticing it was
# also destroying the gate's own caching.
#
# Worse, `/tmp` here is a 62 G **tmpfs -- RAM**, so every push also extracted a
# full worktree into memory on a box where abandoned snapshots are a documented
# contributor to OOM kills (CLAUDE.md), and `scripts/lane-snapshot.sh` already
# exists to keep this kind of scratch on /data0.
#
# So the worktree path is now STABLE and PER-LANE, on disk, and reused across
# pushes. Per-lane because two lanes pushing at once must not share one checkout
# (the same reason lane identity is $AXEYUM_AGENT); stable because that is the
# entire point of a warm cache.
#
# Install (per checkout): git config core.hooksPath hooks
set -euo pipefail
# `-E` so the ERR trap below also fires inside FUNCTIONS (gate_root,
# step_seconds, gated_test): without errtrace a `set -e` exit from a function
# body bypasses the trap, which is how a fourth 17-second silent death got past
# the trap on 2026-09-16. And an xtrace of the whole hook goes to a per-run
# file so the next one is a line number, not a guess.
set -E
_pp_trace="${TMPDIR:-/tmp}/axeyum-prepush-trace.$$.$(date +%s)"
exec 7>"$_pp_trace"
BASH_XTRACEFD=7
set -x
echo "pre-push: xtrace -> $_pp_trace" >&2
# Name the line on any `set -e` exit. Three push batteries on 2026-09-15 died
# 17 s in -- ~3 s after the L0 block, before any named step -- with nothing in
# the log but git's own `failed to push some refs`, and an unchanged retry
# passed each time. Without this trap a transient failure in the lock/slot
# block below is indistinguishable from a kill.
trap 'rc=$?; echo "pre-push: EXITED rc=$rc at line $LINENO: $BASH_COMMAND" >&2' ERR

REPO_ROOT="$(git rev-parse --show-toplevel)"
CALLER_HEAD="$(git rev-parse HEAD)"
CALLER_INDEX="$(git write-tree)"
CALLER_STATUS="$(git status --porcelain=v1)"
ZERO=0000000000000000000000000000000000000000

# Collect the distinct pushed SHAs whose diff-to-remote touches Rust/TOML.
# (A branch delete — local_sha all-zero — is skipped; a new branch diffs from
# its merge-base with origin/main.)
shas_to_gate=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    base="$(git merge-base origin/main "$local_sha" 2>/dev/null || echo "$local_sha~20")"
  else
    base="$remote_sha"
  fi
  # Captured UNCONDITIONALLY (not just when Rust/TOML changed) for the L0
  # block below: a diff-based L0 gate must see the whole PUSHED RANGE, not just
  # its tip commit. Lanes are told to batch several commits into one push
  # (CLAUDE.md), so a gate defaulting to `HEAD~1` would only ever look at the
  # last of them and silently miss a violation three commits earlier in the
  # same push.
  L0_BEFORE="$base"
  L0_TIP="$local_sha"
  # `Cargo.lock` IS LOAD-BEARING HERE AND WAS MISSING, so a dependency bump
  # skipped the ENTIRE battery. Measured 2026-08-27 against a real commit:
  #
  #   git diff --name-only f8173a069~1 f8173a069                 -> 4 files
  #   git diff --name-only f8173a069~1 f8173a069 -- '*.rs' '*.toml' -> 0
  #
  # `Cargo.lock` is not `*.toml`, and it decides which source is compiled. That
  # push exited at the "no cargo gate needed" line below while changing the
  # resolved dependency graph of the whole workspace -- the skip-too-much
  # direction, which this file exists to prevent. Widening, not narrowing: this
  # can only cause the battery to run where it previously did not.
  if [ -n "$(git diff --name-only "$base" "$local_sha" -- '*.rs' '*.toml' 'Cargo.lock' | head -1)" ]; then
    shas_to_gate+=("$local_sha")
    # Kept for the path-conditional suites below, which need the diff range and
    # not just the tip SHA.
    PREPUSH_BASE="$base"
    PREPUSH_TIP="$local_sha"
  fi
done
export PREPUSH_BASE PREPUSH_TIP
export L0_BEFORE L0_TIP

# ---------------------------------------------------------------------------
# L0 trusted-library safety gates (ADR-1050).
#
# These run BEFORE the Rust/TOML early exit below, and that placement is the
# whole point. The L0 gates guard `artifacts/facts/`, the proposition
# corpus, the credit ledger and the blind-evaluation partition -- JSON and
# documentation content, none of which is `*.rs`, `*.toml` or `Cargo.lock`. A
# push touching only those files exits at the "no cargo gate needed" line and
# would be gated by NOTHING. That is exactly the hole this block closes, so
# do not move it below the early exit.
#
# Only the sub-two-second gates run here. Measured warm on s4, single run:
#
#   check-settled-fact-statements     0.09s
#   check-holdout-closed-evaluation   0.06s
#   check-semantic-control-fixtures   1.09s
#   check-partition-edges --baseline  0.13s
#   check-development-partition       0.13s
#   check-autogenesis-holdout-isolation 0.80s
#   check-holdout-adjacency           0.43s
#   check-draw7-frozen-families       0.04s
#   ------------------------------------------
#   total                             ~2.7s
#
# `check-partition-edges.py --baseline` joined on 2026-09-02 (ADR-1546 option
# 2, ADR-1550) and it is the reason this block exists, stated by a measurement
# rather than a principle. The property "no `depends_on` edge crosses an
# evaluation partition" was enforced only by `check-autogenesis-nursery.py`,
# registered in `scripts/check.sh:688` and `justfile:235` and in NO hook -- so
# a producer closed a fact whose dependency fused train and development and
# pushed it, twice on 2026-09-01, with the property never evaluated. By the
# time the ~10-minute gate ran, the finding had been absorbed by an exemption
# re-scoped 228 -> 230 -> 258 -> 274 in four days.
#
# `--baseline` is the RATCHET form, and the distinction matters for cost as
# much as for policy: the full audit attributes all 198 recorded crossings and
# costs 27s, while `--baseline` attributes only edges absent from
# `artifacts/autogenesis/partition-edge-baseline-v1.json` -- normally none --
# and costs 0.13s. It blocks a NEW crossing from today without holding every
# push hostage to a re-partition nobody has done yet.
#
# The four gates below `check-partition-edges` joined 2026-09-02 for the exact
# same reason ADR-1546 names them by: `check-development-partition.py` and
# `check-autogenesis-holdout-isolation.py` were registered only in
# `scripts/check.sh`/`justfile` (~10-minute gate), `check-holdout-adjacency.py`
# likewise, and `check-draw7-frozen-families.py` was invoked by NOTHING AT ALL
# -- not `check.sh`, not `justfile`, not any hook -- so `check-control-
# registration.sh` never saw it either (that gate derives its registry from
# `scripts/tests/*`, not from top-level `scripts/check-*.py`). All four are
# state checks except the last: `check-draw7-frozen-families.py --before <ref>`
# is a DIFF, comparing the pushed range's frozen-family partitions against
# `$L0_BEFORE` (captured unconditionally above, per ref, before the Rust/TOML
# filter) rather than its own default `HEAD~1` -- `HEAD~1` only sees the last
# commit of a push, and lanes are told to batch several commits into one push.
#
# The other four L0 gates are deliberately NOT here and run in CI instead:
# `credit-transaction-ledger` (10.6s), `kernel-differential` (7-27s, and it
# hard-requires a pinned Lean toolchain), `proposition-duplication` (55-72s)
# and `trust-closure` (58s warm, and it shells out to a `cargo run --release`
# kernel example). Adding those here would put ~2.5 minutes in front of every
# push -- including the docs-only pushes that currently cost zero -- and a
# gate people reach for `--no-verify` to escape is worse than no gate.
#
# Fail-closed and unconditional: no `|| true`, no skip switch. If one of these
# exits nonzero the push does not happen.
#
# THAT INCLUDES EXIT 2, and for `check-partition-edges.py` that is a decision
# rather than an oversight. Its three unanswerable causes are "no nursery
# manifest", "no fact ledger" and "no recorded baseline" -- every one of them a
# COMMITTED ARTIFACT missing from the tree being pushed, which is a thing to
# stop for. `scripts/check-merge-hygiene.sh` reports the same exit 2 without
# failing, because a coordinator mid-merge can legitimately be looking at a
# tree where one side has not landed yet. Same code, different question.
# `mutation_controls.py --check-anchors` is here because of a measured rot, not
# on principle. It was registered ONLY in `scripts/check.sh`/`justfile` (the
# ~10-minute aggregate gate), so the lane that breaks an anchor never saw it:
# seven anchors sat stale from `30785cf33` (2026-09-08) until 2026-09-13, and in
# that window a status doc copied the gate's own undercount into prose. The gate
# costs 0.14 s, builds nothing, and needs no toolchain -- there is no cost
# argument for leaving it where only a full-gate run can find it. ADR-1990.
#
# It belongs at L0 specifically: an anchor breaks when RUST moves, but the fix is
# always Python, so a docs/scripts-only push must be gated too -- and L0 is the
# only block that runs before the `shas_to_gate` early exit.
#
# `check-config-registry-staleness.py` joins for the SAME measured reason and was
# the third checker found rotting in that position in one week: registered only
# in `scripts/check.sh:1688` and the `justfile`, so only the ~10-minute aggregate
# gate lanes are steered away from could find it, and it had been exiting 1 on
# main. It belongs at L0 for the mirror-image of the anchors argument: a
# justification goes stale when RUST moves, but the repair is a Python/TSV edit,
# so a docs-only push must be gated too. ADR-2085.
#
# ITS COST WAS NOT FREE AND IS NOT ASSUMED. The brief that asked for this
# registration called the gate "0.1-second-class"; measured on the day, it ran
# 14.6 s against an L0 block whose ten other gates total 4.4 s. That is why
# `40618c358` made it 3.5 s first -- the cost argument had to be removed before
# the registration was honest, not after.
echo "pre-push: L0 trusted-library safety gates (always, incl. docs-only pushes)" >&2
l0_start=$(date +%s)
for l0_gate in \
  "scripts/check-settled-fact-statements.py" \
  "scripts/check-holdout-closed-evaluation.py" \
  "scripts/check-semantic-control-fixtures.py --check" \
  "scripts/check-partition-edges.py --baseline" \
  "scripts/check-development-partition.py" \
  "scripts/check-autogenesis-holdout-isolation.py" \
  "scripts/check-holdout-adjacency.py" \
  "scripts/check-draw7-frozen-families.py --before ${L0_BEFORE:-HEAD~1}" \
  "scripts/check-suite-gating.py" \
  "scripts/tests/mutation_controls.py --check-anchors" \
  "scripts/check-config-registry-staleness.py" \
  "scripts/check-lcg-raw-state.py"
do
  l0_step_start=$(date +%s)
  # Word-splitting is intended: the entries above carry their own flags.
  # shellcheck disable=SC2086
  if ! python3 $l0_gate; then
    echo "pre-push: FAILED - L0 gate rejected this push: $l0_gate" >&2
    exit 1
  fi
  echo "pre-push:   ok $(( $(date +%s) - l0_step_start ))s  $l0_gate" >&2
done
echo "pre-push: L0 safety gates passed in $(( $(date +%s) - l0_start ))s" >&2
# ---------------------------------------------------------------------------

if [ "${#shas_to_gate[@]}" -eq 0 ]; then
  exit 0 # docs/bench-results/scripts-only push — no cargo gate needed
fi

# Gate the TIP pushed SHA (if several refs are pushed at once, the most recent
# code state is the one that must compile; earlier ones are its ancestors).
target_sha="${shas_to_gate[-1]}"

# A persistent, per-lane detached worktree holding exactly the pushed tree —
# isolated from whatever uncommitted WIP sits in this checkout.
#
# Deliberately NOT `mktemp -d`: see the header. A stable path is what makes the
# cache below actually warm. Prefer a real disk; fall back inside the repo's
# target dir; only then /tmp. Override with $AXEYUM_PREPUSH_ROOT.
gate_root() {
  if [ -n "${AXEYUM_PREPUSH_ROOT:-}" ]; then
    printf '%s\n' "$AXEYUM_PREPUSH_ROOT"; return
  fi
  local base
  for base in /data0/axeyum/prepush "$REPO_ROOT/target/prepush-worktrees"; do
    if mkdir -p "$base" 2>/dev/null && [ -w "$base" ]; then
      printf '%s\n' "$base"; return
    fi
  done
  printf '%s\n' "${TMPDIR:-/tmp}/axeyum-prepush"
}
GATE_ROOT="$(gate_root)"
mkdir -p "$GATE_ROOT"

# ONE root for every lane, serialized by flock — deliberately not per-lane.
#
# Keying this by $AXEYUM_AGENT would give each lane its own COLD cache and its
# own ~14 GB target dir, which is the very cost this change exists to remove.
# Sharing one warm cache and taking the lock is strictly better, and the
# serialization is a feature rather than a price: CLAUDE.md's standing rule on
# this box is one cargo job at a time (parallel cargo has crashed s1 AND s4), so
# two lanes must not run this gate concurrently anyway.
if command -v flock >/dev/null 2>&1; then
  exec 9>"$GATE_ROOT/.lock"
  flock 9
fi

# THIS LOCK IS NOT THE CARGO SEMAPHORE, and confusing the two is what made this
# gate the slowest thing on the box. Measured 2026-08-27
# (docs/research/11-design-review/2026-08-27-gate-throughput.md):
#
#   $GATE_ROOT/.lock                      serializes BATTERY against BATTERY
#   /var/tmp/axeyum-cargo.lock.{1..5}     admits five LANE cargo jobs
#
# They are disjoint. Nothing serialized a battery against a lane, so the gate
# ran as a sixth equal consumer of a 16-core box already carrying five
# `nproc`-wide jobs. Every step inflated ~4-7x and the battery went from ~250 s
# to 2,152 s. It is not a regression in any gate; it is starvation.
#
# Two things follow, and NEITHER drops a step. Correctness is not what is being
# traded here -- only scheduling.
#
# 1. The battery runs at nice 0 while `scripts/cargo-serialized.sh` puts lane
#    work at nice 10. Nothing changes on a quiet box; under oversubscription the
#    interactive gate stops being time-sliced against batch work.
export AXEYUM_CARGO_NICE=0
#
# 2. ADVISORY admission: take a cargo slot if one is free, so the battery is
#    counted against the host's memory budget like everything else, and export
#    the marker so nested wrapper calls do not take a SECOND slot.
#
#    Advisory, and fail-OPEN, deliberately. A scheduling mechanism must never be
#    able to block a correctness gate: if every slot is busy we proceed anyway
#    and say so. The alternative -- a battery that waits for the box -- turns a
#    slow gate into a stalled one, and a lane that cannot push is worse than a
#    lane that pushes slowly. The whole benefit here is the nice level, which
#    needs no lock at all; the slot is a bonus when it is free.
prepush_slot_status="none (all busy — proceeding anyway, this is advisory)"
if command -v flock >/dev/null 2>&1; then
  _cargo_lock="${AXEYUM_CARGO_LOCK:-/var/tmp/axeyum-cargo.lock}"
  _slots="$(scripts/cargo-serialized.sh --slots 2>/dev/null || echo 1)"
  for _i in $(seq 1 "$_slots"); do
    if exec 8>"$_cargo_lock.$_i" 2>/dev/null && flock -n 8 2>/dev/null; then
      prepush_slot_status="slot $_i of $_slots"
      export AXEYUM_CARGO_SLOT_HELD=1
      break
    fi
  done
fi
echo "pre-push: cargo admission — $prepush_slot_status; nice 0 (lanes are nice 10)" >&2

echo "pre-push: Rust/TOML changed — compile + fmt gate on pushed SHA ${target_sha:0:12} (mem-capped)" >&2

# Reuse the worktree when it is one of ours; rebuild it otherwise. `--force`
# plus `clean -xdf` make the tree byte-identical to the pushed commit, so the
# gate still examines exactly what is being pushed and nothing else.
#
# `git checkout` stamps only the files it CHANGES, with the current time — so
# unchanged files keep their mtimes (a legitimate cache hit) and changed ones
# look new. That is why this is safe where `git archive | tar -x` is not: the
# stale-mtime trap in CLAUDE.md comes from tar restoring COMMIT times, which can
# put content behind a warm cache and let a gate pass over code it never
# compiled. Checkout cannot do that.
tmp_wt="$(scripts/prepare-prepush-worktree.sh "$REPO_ROOT" "$GATE_ROOT" "$target_sha")"

# A DEDICATED target dir for the gate — persistent, so it stays warm across
# pushes, but NOT shared with the main checkout's.
#
# Sharing `$REPO_ROOT/target` poisoned the main checkout (observed 2026-08-01):
# this gate compiles inside a throwaway `/tmp/axeyum-prepush.XXXX` worktree, so
# the test binaries it produces bake THAT path into `CARGO_MANIFEST_DIR`. Cargo
# then considers the artifact fresh for the main checkout too — same package,
# same features — and the main checkout silently reuses a binary whose manifest
# dir no longer exists. The symptom is a corpus test failing with
# `read_dir(/tmp/axeyum-prepush.ll4jFr/...): No such file or directory` on a
# tree that is perfectly fine, and `cargo test -p <pkg> --lib` passing while
# `cargo test --workspace --lib` fails (different feature unification selects a
# different cached binary). Recovery was `cargo clean -p axeyum-cnf`; the fix is
# to never let this gate write artifacts the main build will pick up.
# Kept beside the worktree so the pair moves together and stays per-lane: two
# lanes sharing one target dir would thrash each other's fingerprints for the
# same path reason described in the header.
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$GATE_ROOT/target}"
(
  cd "$tmp_wt"

  # Runs a cargo test step and FAILS IF IT RAN NOTHING. `cargo test` exits 0 on
  # an empty test binary, so a suite that has been `#![cfg]`-ed out of the
  # selected feature set is indistinguishable from a passing one by exit status
  # alone — which is exactly how the corpus sweep below sat inert for 15 days
  # (see its comment). Mechanism over vigilance: any future feature gate that
  # empties a suite now breaks the push instead of quietly passing it.
  # Per-step wall clock, always reported. A gate whose cost is invisible grows
  # without anyone deciding to grow it: this hook's header still described a
  # "deliberately fast (~seconds hot)" compile-and-fmt check long after it had
  # acquired the workspace unit sweep, the solver `--lib` sweep, the capability
  # frontier ratchet and ten integration suites. Printing the seconds is what
  # makes that visible at the moment someone is paying for it.
  step_seconds() {
    local start=$SECONDS label="$1"
    shift
    # Name the step on failure. Before 2026-09-15 a failing step here returned
    # 1 with NOTHING printed, and a push whose battery died between the L0
    # block and the first cargo scope left a log ending in git's own
    # `failed to push some refs` -- three times in one day, two of them passed
    # by a bare retry. A silent exit is indistinguishable from a kill.
    local rc=0
    "$@" || rc=$?
    if [ "$rc" -ne 0 ]; then
      # (`local rc=$?` would read `local`'s own status, always 0.)
      echo "pre-push: FAILED — ${label} (exit ${rc}, after $((SECONDS - start))s)" >&2
      return 1
    fi
    echo "pre-push:   ${label} — $((SECONDS - start))s" >&2
  }

  gated_test() {
    local label="$1"
    shift
    local out start=$SECONDS
    if ! out="$(MEM_LIMIT_GB="${MEM_LIMIT_GB:-64}" ./scripts/mem-run.sh "$@" 2>&1)"; then
      printf '%s\n' "$out" >&2
      echo "pre-push: FAILED — $label" >&2
      return 1
    fi
    # `grep -c`, not `grep -q`. This is THE nonzero-test-count guard -- the one
    # CLAUDE.md leans on hardest, because a feature-gated suite prints
    # "running 0 tests ... ok" and exits 0 -- and it was built from the idiom
    # that reads a SIGPIPE as "no match": `-q` exits at the first match,
    # SIGPIPEs the `printf`, and `pipefail` (set above) turns 141 into a
    # non-match, so the negation fires and a passing step is reported as inert.
    # Fail-closed, so it cost a spurious push block rather than an admitted bad
    # push -- but it went unscanned until `check-shell-antipatterns.sh` learned
    # to read `hooks/` on 2026-08-30. `grep -c` consumes all input.
    if [ "$(printf '%s\n' "$out" | grep -cE '^running [1-9]')" -eq 0 ]; then
      printf '%s\n' "$out" >&2
      echo "pre-push: FAILED — $label ran ZERO tests (a feature gate has emptied" \
           "it; this step is inert, not passing)" >&2
      return 1
    fi
    echo "pre-push:   ${label} — $((SECONDS - start))s" >&2
  }

  gate_started=$SECONDS
  # `--all-targets` IS LOAD-BEARING, and its absence let a non-compiling
  # workspace onto `main` on 2026-08-20 under the message "pushed SHA compiles".
  #
  # `cargo check --workspace` builds lib and bin targets and NOT `examples/` or
  # `tests/`. Adding one `Evidence` variant broke the exhaustive `match` in
  # `crates/axeyum-bench/examples/{audit_dominance,diagnose_evidence}.rs`; this
  # step passed, the hook printed its green line, and the break was found later
  # by running one of those examples by hand. The type system had the answer the
  # whole time — the gate simply never asked the compiler about half the tree.
  #
  # It is close to free: measured on this host, 13s cold and **0s warm**, against
  # a step already documented at 0s. `scripts/check.sh` was never blind to this
  # (its clippy wrapper is `--all-targets`), so the aggregate gate would have
  # caught it — which is exactly why the narrower gate must not claim
  # "compiles" for a subset of what compiles.
  #
  # Control: scripts/tests/test-prepush-checks-all-targets.sh
  step_seconds "cargo check --workspace --all-targets" \
    env MEM_LIMIT_GB="${MEM_LIMIT_GB:-64}" ./scripts/mem-run.sh cargo check --workspace --all-targets --quiet
  step_seconds "cargo fmt --all --check" cargo fmt --all --check
  # clippy -D warnings over the whole workspace. Until 2026-08-31 this hook had
  # NO clippy step at all — the word appeared exactly once, in this file's own
  # comments, never in an invocation — so a workspace clippy failure (exit 101,
  # measured against `main`) went through the hook clean, twice, before it was
  # caught by hand and repaired (579d3e02).
  #
  # `scripts/check-clippy-complete.sh`, not the bare `cargo clippy` command:
  # cargo decides freshness by mtime, so a source file OLDER than the cached
  # artifact is invisible to clippy and a bare `-D warnings` can exit 0 over
  # code it never recompiled (measured 2026-08-14, see the script's own header
  # and CLAUDE.md). The wrapper touches changed content first via
  # `check-source-freshness.sh`, then reports how many workspace targets it
  # actually linted and fails if that count is zero — the same
  # nonzero-count discipline `gated_test` applies to test suites, done here for
  # a lint pass instead.
  step_seconds "clippy --workspace --all-targets --all-features -D warnings" \
    env MEM_LIMIT_GB="${MEM_LIMIT_GB:-64}" ./scripts/mem-run.sh ./scripts/check-clippy-complete.sh
  # The oracle-free :status corpus sweep (~6s warm): CI's copy caught a
  # vacuous-sat harness hole (f5b00c72) only AFTER the SHA was public —
  # a wrong verdict must never leave the machine when a 6-second local
  # sweep can catch it.
  #
  # `--features full` is LOAD-BEARING and its absence made THIS GATE ITSELF
  # VACUOUS for 15 days: `4464dae2` (2026-07-17, "make qfbv the audited
  # deployment default") put `#![cfg(feature = "full")]` on the suite, so from
  # that commit until 2026-08-01 this step compiled an empty test binary and
  # printed "running 0 tests ... ok". A gate built to catch a vacuous-sat hole
  # had itself become vacuous, and it looked green the entire time. Every
  # `--test <name>` line in this hook must be spot-checked for a nonzero test
  # count, not merely for a zero exit status.
  gated_test "corpus :status sweep" \
    cargo test -p axeyum-solver --features full --test corpus_regression --quiet
  # The EXTERNAL SAT referee (ADR-1910, ~2s warm): the native CDCL core's
  # verdicts adjudicated by CaDiCaL/Kissat reading the DIMACS TEXT we wrote.
  #
  # It is in this hook because the referee it replaces was in NO hook, no gate,
  # no CI job and no recipe -- measured 2026-09-10 with positive controls -- so
  # the `rustsat-batsat` differential had adjudicated nothing automatically in
  # the whole of its life. Shipping its replacement into the same three blind
  # spots would have reproduced the defect rather than fixed it.
  #
  # `step_seconds`, not `gated_test`: the wrapper already asserts a nonzero TEST
  # count AND re-derives the adjudicated comparison count from the suite's own
  # `compared=N` reports, failing below a floor. `gated_test`'s `^running [1-9]`
  # probe would not match the wrapper's output anyway.
  #
  # Absent binary => a loud SKIP and exit 0, like `abc-crosscheck`: these are
  # external C/C++ applications and NOT Cargo dependencies, so a push must not
  # depend on a host having built them. `AXEYUM_REQUIRE_EXTERNAL_SAT=1` turns
  # absence into a failure on a host that is supposed to have them.
  step_seconds "external SAT referee (ADR-1910)" ./scripts/check-external-sat-referee.sh
  # The WORKSPACE unit sweep (~40s warm): a wrong-unsat unit test
  # (int_mod_by_zero_underspecification, 52f3b1d1) shipped to main because a
  # lane ran targeted `--test <file>` + fuzzes but not `--lib` — the corpus
  # sweep above misses soundness holes on shapes that are neither in the
  # committed corpus nor hit by a differential-fuzz generator. Scoped to the
  # WHOLE workspace, not `-p axeyum-solver`: that P0's defect actually lived in
  # `axeyum-rewrite` (8th-review finding), so a solver-only sweep is a
  # half-measure — a soundness hole reachable only through a rewrite/strings/bv
  # unit test would still slip. ("full sweep catches what per-commit --test
  # misses", enforced workspace-wide at the push boundary.)
  # THE WORKSPACE UNIT SWEEP MOVED OUT on 2026-08-19. It ran `cargo test
  # --workspace --lib` on every Rust push: 218 s uncontended at its last honest
  # measurement, and **2,699 s** in a real push once `axeyum-lean-kernel`'s lib
  # tests grew (CReal, its inverse, the lattice, and Complex all landed in that
  # crate in a day; a dozen of its tests now exceed 60 s each). It was also
  # DOUBLE-CHARGED: the kernel step below ran `-p axeyum-lean-kernel` wholesale,
  # which includes the same `--lib` tests.
  #
  # It exists because a P0 wrong-unsat lived in `axeyum-rewrite`, not in the
  # solver, so a `-p axeyum-solver` sweep would not have caught it. That coverage
  # is NOT lost: `cargo nextest run --profile local --workspace --all-features`
  # in `scripts/local-ci.sh` is a strict superset, and
  # `scripts/check-local-ci-freshness.sh` is ENFORCING in `just check` and
  # `scripts/check.sh` — a battery record that is stale, failing, vacuous or
  # unreadable reds the aggregate gate. The battery moved from every-push to
  # must-have-run-recently, which is the cadence it was always worth.

  # ...and the step above runs on DEFAULT features, under which `axeyum-solver`
  # compiles **23** of its **968** unit tests (measured 2026-08-01): everything
  # behind `#[cfg(feature = "full")]` — the whole multi-theory surface, strings,
  # e-graph, FP, smtlib — silently vanishes. The wrong-unsat that motivated the
  # sweep above would have been caught either way, but a soundness hole in any
  # `full`-gated module would sail through a "green" workspace sweep. `full` is
  # pure Rust (the C/C++ z3 backend is a separate feature), so requiring it here
  # keeps the no-C-dependency promise intact.
  # `--skip reconstruct::` is why this step is 31s and not 294s.
  #
  # Measured 2026-08-20 on an IDLE box (load 1.03, zero other cargo): the 1008
  # solver unit tests run in **31s**; the 268 `reconstruct::` tests take
  # **294s**, because each builds Lean preludes. They were 90% of this step and
  # ~45% of the entire push, on every push touching a single `.rs` file.
  #
  # They are not what this step exists for. The sweep was added because a
  # wrong-`unsat` unit test shipped (52f3b1d1) — a SOLVER soundness defect. The
  # `reconstruct::` tests check that a Lean module is built correctly, which is
  # a different property, caught by `lean-gate` and by the reconstruct sweep now
  # registered in `scripts/check.sh` and the justfile. Nothing is dropped; the
  # daily gate keeps them and every git round stops paying for them.
  #
  # The comment at the top of this file said this step cost 30s. That was true
  # once. Timings in a comment rot; these were re-measured today.
  gated_test "solver unit sweep (full, minus Lean reconstruction)" \
    cargo test -p axeyum-solver --lib --features full --quiet -- --skip reconstruct::

  # The KERNEL's integration suites. `cargo test --workspace --lib` above runs
  # unit tests only and SKIPS every `tests/*.rs`, which is how
  # `axeyum-lean-kernel --test axiom_footprint` sat RED on main for a day: the
  # commit that made `Int.euclidean_decomposition` a theorem left three
  # assertions still describing it as an axiom, and nothing at push time looked.
  # CLAUDE.md warns about exactly this ("`--lib` IS NOT A SUFFICIENT PRE-MERGE
  # GATE ON ITS OWN"), and the warning was not enough on its own.
  #
  # This is the crate where the trusted surface is asserted, so a stale
  # assertion here is a stale claim about axiom-freedom. That coverage is why
  # the step exists and it is NOT being reduced.
  #
  # SPLIT, 2026-08-19, because it ran the crate WHOLESALE. Fifteen of the crate's
  # 46 integration suites hand generated modules to a real `lean`, and
  # `scripts/check-lean-gate.sh` already owns those -- with a toolchain pin, a
  # counted floor and a no-skip rule, none of which this step had. So every push
  # ran them twice, and the comment here said "~1.4s warm". Measured warm on s4
  # 2026-08-19, in a snapshot tree whose target dir was already built:
  #   BEFORE  cargo test -p axeyum-lean-kernel            2,296 s
  #   AFTER   check-kernel-suites.sh --no-lib                80 s  (31 suites, 188 tests)
  # for a hook that runs 722-1,176 s in total when healthy.
  #
  # `scripts/check-kernel-suites.sh` DISCOVERS which half a suite is in (it
  # carries `#[path = "support/lean_probe.rs"]`, or it does not) and FAILS if any
  # suite is in neither -- so removing the duplication cannot silently create a
  # suite that nothing runs. It found one the first time it ran.
  #
  # `--no-lib`: the workspace unit sweep two steps above already runs this
  # crate's unit tests, and several of them take over 60 s each.
  #
  # SCOPED TO THE DIFF, and unlike the frontier ratchet's filter this one is
  # DERIVED rather than judged: `crates/axeyum-lean-kernel/Cargo.toml` has
  # exactly one dependency, `num-bigint`, and nothing from this workspace. No
  # change under another crate can move these suites. The manifests are in the
  # filter for the lint/version surface, and the two gate scripts for their own
  # sake. The partition assertion is cheap (no cargo) and runs EITHER WAY: it is
  # what makes the skip safe, since it is the thing that notices a real-Lean
  # suite dropping out of `check-lean-gate.sh`'s table.
  if [ -n "$(git diff --name-only "$PREPUSH_BASE" "$PREPUSH_TIP" -- \
      'crates/axeyum-lean-kernel/**' \
      'scripts/check-kernel-suites.sh' \
      'scripts/check-lean-gate.sh' \
      'Cargo.toml' 'Cargo.lock' | head -1)" ]; then
    echo "pre-push: Lean kernel changed — kernel suites (non-Lean integration)" >&2
    step_seconds "kernel suites (non-Lean integration)" \
      env MEM_LIMIT_GB="${MEM_LIMIT_GB:-64}" ./scripts/mem-run.sh \
      ./scripts/check-kernel-suites.sh --no-lib
  else
    echo "pre-push: no Lean kernel change — kernel suites SKIPPED (partition still asserted)" >&2
    step_seconds "kernel suite partition" ./scripts/check-kernel-suites.sh --list
  fi

  # THE CAPABILITY FRONTIER RATCHET MOVED OUT on 2026-08-19, to
  # `scripts/local-ci.sh`, where it runs serialized with `--test-threads=1`.
  #
  # It exists because a 17-point `nia_unsat` regression once shipped and needed
  # an 829-commit bisect: it is the only gate that notices we got WEAKER without
  # getting WRONG. That is worth keeping, and it is kept — but not here.
  #
  # Moving it makes it STRONGER, which is the only reason it was allowed to
  # move. It measures the largest N decided within a fixed WALL-CLOCK budget, so
  # contention does not slow it down, it corrupts it: CLAUDE.md records the same
  # commit on the same box scoring 35 (load 34), 39 (load 5.4) and 40 (idle).
  # Each family calibrates the machine and marks a run NOT COMPARABLE or
  # ADVISORY ONLY when the frame moved. In this hook, with several lanes on the
  # box, it was **200 s of a 545 s baseline** spent mostly being advisory —
  # paying full price for a verdict it then declined to enforce.
  #
  # `scripts/check-local-ci-freshness.sh` is ENFORCING in `just check` and
  # `scripts/check.sh`, so a battery record that is stale, failing, vacuous or
  # unreadable reds the aggregate gate. The ratchet did not become optional; it
  # became something that must have run recently.

  # The ALWAYS-ON integration slice: four cheap `tests/*.rs` suites (measured
  # 2026-08-04: 0.00s + 0.01s + 0.00s + 0.82s warm) that no fast gate ran.
  #
  # All four were FAILING on main on 2026-08-04, one of them
  # (`deep_nesting_no_abort::deep_int_add_source_returns`) with a STACK
  # OVERFLOW — an abort, which is strictly worse than a timeout because the
  # solver cannot report the first-class `unknown` it owes its caller and a
  # harness reads the exit as a crash. They failed identically at older commits,
  # so this was accumulated drift, invisible because every fast gate is `--lib`
  # (which skips `tests/*.rs` entirely) and the only gate that would have caught
  # them, `./scripts/check.sh --workspace --all-features`, needs libz3 and tens
  # of minutes. Cheap suites that pin a load-bearing invariant belong here, not
  # only in the aggregate gate.
  #
  #   capabilities            — the capability-matrix golden; the trust metadata
  #                             users read must equal what the ledger renders.
  #   deep_nesting_no_abort   — the no-abort ratchet for source-controlled
  #                             nesting depth (`unknown` is a hard-rule result;
  #                             SIGABRT is not a result at all).
  #   evidence_lia_cert       — arithmetic UNSAT certificates re-check, and a
  #   evidence_bv2nat_cert      tampered one is REJECTED.
  #
  # `--features full` is LOAD-BEARING on every one: all four are
  # `#![cfg(feature = "full")]`, so without it each compiles to an empty binary
  # that prints "running 0 tests ... ok". `gated_test` fails on a zero count, so
  # that trap is mechanised rather than remembered.
  for suite in capabilities deep_nesting_no_abort \
               evidence_lia_cert evidence_bv2nat_cert; do
    gated_test "integration: $suite" \
      cargo test -p axeyum-solver --features full --quiet --test "$suite"
  done

  # DISPATCH AND GIVE-UP-REASON gates. Added 2026-09-12 after `main` sat RED for
  # ~2 hours on `unknown_reason_coverage` across three lane merges and a GREEN
  # PUSH WENT OUT OVER IT, because this hook named none of these suites.
  #
  # They are not here because they are new; they are here because each one
  # failing is invisible to everything else this hook runs. The whole set costs
  # under a tenth of a second — measured 2026-09-12: 0.00/0.00/0.01/0.03/0.00/
  # 0.01 s — so cost is not the reason they were missing. Nobody added them.
  #
  #   unknown_reason_coverage  — every give-up carries a reason a reader can
  #                              act on. The division censuses this project
  #                              plans from are read off exactly those strings,
  #                              so a silent `unsupported` corrupts the roadmap,
  #                              not just a log line.
  #   route_attribution        — DELIBERATELY NOT HERE: same family, but 113 s,
  #                              a 20% addition to this battery. It needs a
  #                              decision about budget, not a quiet include.
  #   dt_uf_gate               — ADR-1920's capability gate.
  #   dt_capability_1935       — ADR-1935's exactness precondition and the
  #                              messages the blocker census is read from.
  #   datatype_solve_path      — the native datatype route stays reachable.
  #   dt_nested_field_2128     — ADR-2128's nested datatype FIELD expansion,
  #                              behind a dated lever that is OFF by default.
  #                              Registered here because the suite's value is
  #                              a DIFFERENCE between two arms: its
  #                              `off_arm_refuses_the_nested_congruence` is
  #                              the non-vacuity control, and it fails if the
  #                              lever ever defaults ON or if the OFF arm
  #                              starts deciding the query by another route —
  #                              either of which would make every A/B run
  #                              against it meaningless without failing
  #                              anything else.
  #   dt_array_element_2135    — ADR-2135's opaque array-of-datatype FIELD,
  #                              behind a dated lever that is OFF by default.
  #                              Registered for the same reason as
  #                              `dt_nested_field_2128`: the suite's value is a
  #                              DIFFERENCE between two arms, and its
  #                              `off_is_the_shipped_default_with_no_guard_and_no_env`
  #                              fails if the lever ever defaults ON — which
  #                              would silently change the encoding for every
  #                              lane without failing anything else. Its
  #                              `select_of_the_opaque_field_declines_it_does_not_error`
  #                              is the traversal guard that makes the admission
  #                              sound, and its `sound_*` pair is the ADR-1930
  #                              wrong-`unsat` shape on the new field class.
  #   quant_ladder_rung_refusal_declines
  #                            — ADR-1927: a rung's fragment refusal is a
  #                              DECLINE, not the query's verdict. Regressing
  #                              this silently costs whole divisions (it was
  #                              worth +51 files when fixed).
  #   additive_no_overflow_never_becomes_unsat
  #                            — ADR-1937 soundness-negative: the additive
  #                              constraint must never turn a `sat` into an
  #                              `unsat`.
  #
  # `--features full` is load-bearing here too; `gated_test` fails on a zero
  # count, so the empty-binary trap is mechanised rather than remembered.
  #   dt_constructor_arg_1942  — ADR-1942's constructor-argument congruence and
  #                              the free-generation axioms it builds the
  #                              antecedent from (distinctness / injectivity /
  #                              mixed). Added 2026-09-12 BY THE RATCHET, which
  #                              refused the push until this suite was named —
  #                              its first real catch.
  #   dt_valued_result_1946    — ADR-1946: a datatype-VALUED UF result, and the
  #                              `Op::Apply` datatype argument its witness makes
  #                              admissible. Worth +35 files across the three DT
  #                              divisions, so a silent regression here is a
  #                              division-scale loss. Named at the same time as
  #                              the suite was written rather than after the
  #                              ratchet refused the push — which is what the
  #                              ratchet is for.
  #   nested_array_gate_map    — ADR-1955/ADR-1965: the CHAIN of gates behind
  #                              the nested array sort, in one file. Its gate-1
  #                              test FIRED (ADR-1965 admitted the sort) and is
  #                              now `nested_array_sort_parses_and_round_trips`;
  #                              four of its ten tests still assert a capability
  #                              we do NOT have and fail LOUDLY when it arrives,
  #                              because ADR-1965's reach measurement rests on
  #                              exactly which of them hold. 0.11 s.
  #   nested_array_row         — ADR-1965: the SOUNDNESS fence around admitting
  #                              `(Array I (Array J E))`, which is the widest
  #                              population this repository has admitted at once
  #                              (27,150 files in four divisions). Every test is
  #                              a satisfiable query that must never return
  #                              `unsat` or an unsatisfiable one that must never
  #                              return `sat`, with three positive controls so
  #                              the file cannot pass as a solver stuck on
  #                              `unknown`. Every verdict is cross-checked
  #                              against z3 4.13.3 and cvc5 1.3.4. 0.14 s.
  #   real_element_array_row   — ADR-1960 soundness-negative: the `(Array _ Real)`
  #                              element sort through the lazy ROW CEGAR. Three
  #                              gates were lifted to reach it, so five of its
  #                              nine tests are adversarial fixtures over
  #                              SATISFIABLE queries whose plausible wrong answer
  #                              is `unsat` — including `0 < m[i] < 1`, which is
  #                              sat over Real and unsat over Int and is
  #                              therefore the one test that dies if anything on
  #                              the route integralizes the element. Its `Sat`
  #                              rows replay the model against the ORIGINAL
  #                              assertions inside the test, because the route's
  #                              own replay is part of the subject. 0.11 s.
  #   dispatch_rung_refusal_declines
  #                            — ADR-1966: ADR-1927's rule, but for the GROUND
  #                              theory ladder in `check_auto_dispatch`. Its
  #                              fixtures each carry `x > 0 AND x < 0`, so the
  #                              `unsat` needs no solver to see and a failure
  #                              can only mean the ladder stopped at a rung's
  #                              refusal. The population behind it is
  #                              enumerated by
  #                              `scripts/enumerate-dispatch-refusal-propagation.py`.
  #   quant_egraph_reserve_row — ADR-1970 soundness-negative: the quantified
  #                              ladder's `q:egraph` budget reserve
  #                              (`AXEYUM_QUANT_EGRAPH_RESERVE`). Re-ordering a
  #                              ladder's CLOCK changes which rung answers, and
  #                              a rung that answers by an unsound instantiation
  #                              yields a wrong `unsat`. So every fixture runs
  #                              under ALL THREE arms (`WholeBudget`, reserve
  #                              1/4, and the `share = 1` ceiling arm the census
  #                              sizing uses), and each adversarial SATISFIABLE
  #                              query is pinned `Sat` -- not merely `not
  #                              unsat` -- because an `unknown` would skip the
  #                              in-test model replay and leave the adversarial
  #                              half checking nothing. Each has an `unsat` twin
  #                              in the same file differing in ONE small term.
  #                              0.02 s.
  #   quant_valid_universal_reserve_row
  #                            — ADR-1975 soundness-negative: the quantified
  #                              ladder's valid-universal-elimination budget
  #                              reserve
  #                              (`AXEYUM_QUANT_VALID_UNIVERSAL_RESERVE`). Same
  #                              three-arm shape as `quant_egraph_reserve_row`,
  #                              plus one hazard that pass has and `q:egraph`
  #                              does not: this rung REWRITES the assertion set,
  #                              replacing a universal it proved valid with
  #                              `true`, and proving validity is a SUB-SOLVE
  #                              that a bounded budget can cut off mid-flight.
  #                              `a_nonvalid_universal_refuted_at_one_ground_term_is_unsat_under_any_arm`
  #                              is the file that sees an elimination on an
  #                              unfinished sub-solve: delete that universal and
  #                              the residual is satisfiable, so a wrongly
  #                              eliminating pass turns its `unsat` into `sat`.
  #   qinst_egraph_retry_share_row
  #                            — ADR-1995 soundness-negative: the SKOLEMIZED
  #                              e-graph retry's budget share
  #                              (`AXEYUM_QINST_EGRAPH_RETRY_SHARE`). Same
  #                              three-arm shape as the two above, and it is
  #                              here for a reason the other two do not have:
  #                              this rung is the e-graph instantiation loop's
  #                              SECOND run on the same query, and the loop's
  #                              own round admission asks whether another round
  #                              fits WITH GROWTH HEADROOM against the remaining
  #                              budget (`qinst_egraph.rs:2267`). Changing the
  #                              share therefore changes the loop's ROUND
  #                              SCHEDULE, not just how long it runs -- so the
  #                              arms can reach the final ground check with
  #                              DIFFERENT accumulated ground, which is exactly
  #                              the situation in which one arm's refutation is
  #                              not the other's. `the_retry_rung_applies_the_
  #                              arms_budget` is the load-bearing one: it reads
  #                              the budget back from the dispatch site, so
  #                              reverting that site to the bare constant fails
  #                              it while every arithmetic test stays green.
  #   distinct_linear_soundness
  #                            — ADR-2000 soundness-negative: the linear
  #                              `distinct` encoding (`AXEYUM_DISTINCT_LINEAR`).
  #                              It is here because the FRONT DOOR'S MODEL REPLAY
  #                              DOES NOT COVER THIS REWRITE: `check_model` runs
  #                              against `solved.assertions`, which are the
  #                              PARSER-PRODUCED assertions, so a model of the
  #                              encoding is replayed against the encoding and
  #                              proves nothing about `distinct`. The `sat`
  #                              direction is safe only because the encoding is
  #                              strictly STRONGER — an argument, not a check —
  #                              so these assertions are the only thing standing
  #                              between a weakened encoding and a wrong `sat`.
  #                              `check-suite-gating.py` caught it unregistered
  #                              at the push that would have shipped it.
  #   parser_desugar_soundness
  #                            — ADR-2010 soundness-negative: the parser's two
  #                              UNCONDITIONAL s-expression desugars,
  #                              `desugar_sets` and `desugar_const_arrays`.
  #                              Both shipped wrong verdicts through the default
  #                              front door — no lever, no feature gate — and
  #                              BOTH ARE INVISIBLE TO THE MODEL REPLAY, for two
  #                              different structural reasons. `desugar_sets`
  #                              rewrites `(Set E)` to `BitVec` on the
  #                              s-expression tree BEFORE any term is built, so
  #                              the source set terms never become IR terms and
  #                              there is nothing for `check_model` to evaluate
  #                              them against (replaying against "the originally
  #                              parsed assertions" would not help: the original
  #                              parse IS the encoding). `desugar_const_arrays`
  #                              is a STRENGTHENING rewrite and the replay only
  #                              ever inspects `sat`, so it cannot fire on a
  #                              manufactured `unsat` however it is implemented.
  #                              Unlike distinct_linear_soundness below, neither
  #                              rewrite has a lever to turn off — these
  #                              assertions are the whole gate.
  #   quantifier_positive_path
  #                            — ADR-2120: the positive-path activation lever's soundness
  #                              fixtures and its instance-set certificate.
  #   quant_macro_inline_route
  #                            — ADR-2127: definitional macro inlining. Its three
  #                              soundness fixtures are stated over SATISFIABLE
  #                              queries (occurs check, partial coverage, and a
  #                              consistent definition), because a refutation
  #                              fixture cannot tell "refused the macro" from
  #                              "inlined it and the query was unsat anyway".
  #                              RUN TWICE, and the second run is the one that
  #                              matters: `AXEYUM_MACRO_INLINE` is read once per
  #                              process through a `OnceLock`, and it ships OFF,
  #                              so the default-arm run exercises a code path the
  #                              lever keeps disabled. Gating only the default arm
  #                              would register a suite that cannot fail for the
  #                              reason it exists. The armed run is the line after
  #                              this loop.
  #   quant_session_arith_certificate
  #                            — ADR-2130: every `Unsat` exit of
  #                              `prove_quantified_unsat_via_egraph_impl` assigns an
  #                              instance-set certificate first. A SOURCE invariant,
  #                              not a behavioural fixture, and registered here
  #                              deliberately: ADR-2124 repaired one such exit and
  #                              MEASURED that nothing noticed the repair being
  #                              removed — 9 tests of the whole
  #                              `quant_instance_set_cert::` surface ran and all 9
  #                              SURVIVED. Carries its own non-vacuity controls on
  #                              the function body it read and on the exit count, so
  #                              a rename or a shrunken body fails rather than
  #                              quantifying over nothing.
  #   quant_ground_session_soundness
  #                            — ADR-2124: the ground-session lever's soundness-negative
  #                              fixtures over SATISFIABLE UFLIA queries at levels 0
  #                              and 1, plus the two positive controls that stop the
  #                              suite passing against an engine deciding nothing and
  #                              the differential's own `compared >= 2` guard against
  #                              a vacuous comparison.
  #   quantifier_trigger_alternatives
  #                            — ADR-2113: the trigger-alternative lever's soundness-
  #                              negative fixtures over satisfiable queries at six caps.
  #   quant_generation_ladder
  #                            — ADR-2133: the generation ladder on the final
  #                              refutation check, at levels 0 and 1. The lever is
  #                              strictly ADDITIVE (every layer is a subset of the
  #                              conjunction the full check already takes), so it has
  #                              no `sat` path and the usual "a sat claimed too early"
  #                              fixture has no analogue; the failure mode it really
  #                              has is a ladder whose non-refutation SWALLOWS the
  #                              full check, which is what the two `UNSAT_` fixtures
  #                              are for — and those are simultaneously the positive
  #                              controls that stop the two satisfiable fixtures
  #                              passing against an engine that decides nothing.
  #                              Layer PRECISION is pinned in `qinst_egraph`'s unit
  #                              tests, where generations can be constructed exactly;
  #                              mutation-checked at `quant-generation-ladder`.
  #   quant_nested_activation_2149
  #                            — ADR-2149: a universal nested INSIDE another
  #                              universal's body, step by step through the
  #                              in-process `NestedActivationStats` counters:
  #                              the static crossed-binder registration is inert
  #                              and its tuples dropped in the `crossed-binder`
  #                              class, while the refutation comes through the
  #                              registrations discovery adds from the enclosing
  #                              instance. Four SAT twins at both levels through
  #                              the loop and the front door; the flat-prefix
  #                              positive control; the split's partition
  #                              invariants; the certificate chain check.
  #   decline_detail_typed
  #                            — ADR-2104: every DeclineReason detail is a closed
  #                              enum with an exhaustive name(); this suite DRIVES
  #                              each producer that can be reached from a query.
  #                              Landed without a gate; the suite-gating L0 check
  #                              refused the push, which is what it is for.
  #   replay_pairing_soundness
  #                            — ADR-2070: `SmtLibSolved.assertions` and
  #                              `.model` must be an actual PAIR. The string
  #                              second chances decide against the SOURCE
  #                              expressions and bind the parser's `!weq!<name>`
  #                              sequence mirrors, while `assertions` stayed the
  #                              PACKED flat vector over the declared names at
  #                              `(_ BitVec string_total(m))` — different
  #                              SymbolIds, names and sorts, so the replay could
  #                              not evaluate at all (measured: 5 of 109 `sat`
  #                              over the 217 string-division files). The
  #                              verdicts were right; the damage was a FALSE
  #                              ALARM, confirmed end to end through
  #                              `axeyum-py`'s `Outcome.replay()` answering
  #                              `False` on four of the five and `True` on the
  #                              fifth over a substituted all-empty model.
  #                              The pairs here straddle the packed cap
  #                              (`STRING_MAX_LEN = 12`) by ONE numeral, so a
  #                              build that withheld every string `sat` and a
  #                              build that paired every one each fail exactly
  #                              one half — neither can pass by doing less.
  #                              `the_replay_can_still_answer_false` is the
  #                              load-bearing one: the repair guards on
  #                              COMPLETENESS of the binding, never on
  #                              satisfaction, so the downstream `check_model`
  #                              keeps its power to reject. Registered here
  #                              because ADR-2000's soundness suite shipped
  #                              registered nowhere and `check-suite-gating.py`
  #                              caught it at the push.
  #   lra_warm_screen_2132     - ADR-2132's builds-per-file screen for the warm
  #                              simplex basis. Three arms of one lever in ONE
  #                              process, because the property is that they
  #                              AGREE on the verdict and the lever is memoised
  #                              per process: three separate binaries could
  #                              assert each arm only against a verdict written
  #                              into their own source. Both mechanism halves are
  #                              asserted from the counters, so neither test can
  #                              pass by never opening the screen -- ADR-2125's
  #                              own arm was INERT and only a mechanism probe
  #                              said so. Registered here rather than left to the
  #                              `--lib` sweep, which does not compile
  #                              `tests/*.rs` at all.
  for suite in unknown_reason_coverage dt_uf_gate dt_capability_1935 \
               dt_constructor_arg_1942 dt_valued_result_1946 \
               datatype_solve_path quant_ladder_rung_refusal_declines \
               nested_array_gate_map nested_array_row real_element_array_row \
               dispatch_rung_refusal_declines quant_egraph_reserve_row \
               quant_valid_universal_reserve_row qinst_egraph_retry_share_row \
               distinct_linear_soundness parser_desugar_soundness \
               replay_pairing_soundness \
               additive_no_overflow_never_becomes_unsat \
               lra_opaque_real_apps decline_detail_typed \
               quantifier_trigger_alternatives quantifier_positive_path \
               dt_nested_field_2128 dt_array_element_2135 \
               quant_macro_inline_route quant_ground_session_soundness \
               nra_clause_cert_2131 \
               quant_session_arith_certificate quant_generation_ladder lra_warm_screen_2132 \
               nra_algebraic_witness model_preference_2140 \
               canonical_constraint_cache_2144 quant_nested_activation_2149; do
    gated_test "dispatch/reason: $suite" \
      cargo test -p axeyum-solver --features full --quiet --test "$suite"
  done

  # ADR-2127's ARMED arm. See the `quant_macro_inline_route` note above: the
  # lever ships OFF and is read once per process, so the loop's run above covers
  # only the disabled path. This is the run in which the three satisfiable-query
  # soundness fixtures actually reach the inlining code.
  gated_test "dispatch/reason: quant_macro_inline_route (AXEYUM_MACRO_INLINE=1)" \
    env AXEYUM_MACRO_INLINE=1 \
      cargo test -p axeyum-solver --features full --quiet --test quant_macro_inline_route

  # ADR-2135's ARMED arm, for the same reason as the line above: the process
  # value of `AXEYUM_DT_ARRAY_ELEMENT` is resolved once per process, so the loop
  # run reaches the admission arm only through the thread-local guard. This run
  # exercises the ENV path itself -- the one a benchmark sweep actually uses --
  # and would catch a parse that silently resolved `on` to the default. The
  # suite's two `off_*` tests assert the shipped default and are skipped by name
  # here, because with the variable set they are asserting the wrong arm.
  gated_test "dispatch/reason: dt_array_element_2135 (AXEYUM_DT_ARRAY_ELEMENT=on)" \
    env AXEYUM_DT_ARRAY_ELEMENT=on \
      cargo test -p axeyum-solver --features full --quiet --test dt_array_element_2135 \
        -- --skip off_

  # ADR-2145's session fuzz for the INCREMENTAL QF_BV path: random
  # push/assert/check/pop streams over one retained `IncrementalBvSolver`,
  # every verdict against a fresh one-shot solve of the live set (and z3 when
  # that feature is on, which it is not here), every `sat` replayed. Both arms
  # of `warm_keep_trail` run from one binary (the field is set explicitly, so
  # the process-wide lever is not what selects them). Until 2026-09-17 no gate
  # compared the warm engine's verdicts on a SEQUENCE against anything -- the
  # one-shot fuzzes cannot reach a popped scope leaking into the next check.
  # 60 sessions per arm here (~25 s); the committed default is 150.
  gated_test "dispatch/reason: incremental_bv_session_fuzz (AXEYUM_INCR_SESSIONS=60)" \
    env AXEYUM_INCR_SESSIONS=60 \
      cargo test -p axeyum-solver --features full --quiet --test incremental_bv_session_fuzz

  # The GOLDEN LEAN MODULE pins, diff-scoped to the crate that renders them.
  #
  # Every module the kernel renders opens with a fixed banner, and until
  # 2026-08-18 that banner was inside every golden byte pin in the workspace. A
  # commit that changed it re-pinned the goldens it happened to run and shipped
  # the same delta unannounced onto the rest -- THREE times (`0fc7cc357`,
  # `b760fd6ae` +863, `46724faec` +777). `main` was red for a day and the first
  # ever completed `scripts/local-ci.sh` run found it, 6,400 seconds in.
  #
  # The pins now cover the module BODY and the banner has its own committed-text
  # pin, so a header change fails one named thing instead of five unnamed ones.
  # This step is the other half: those five are `tests/*.rs` integration targets,
  # which `--lib` skips by construction and which this hook -- naming six of the
  # workspace's 465 -- did not name.
  #
  # Scoped to `axeyum-lean-kernel/src/**` because that is where all three
  # recurrences came from: two from `lean_pp.rs` (the banner itself) and one from
  # `int_prelude.rs` (axioms became theorems, so their proof terms are emitted).
  # A solver-side reconstruction change can also move a body pin; that is caught
  # by `just check` / `scripts/check.sh`, where this same script always runs.
  # Measured warm on s4: see docs/plan/notes/agent-golden-pins.md.
  if [ -n "$(git diff --name-only "$PREPUSH_BASE" "$PREPUSH_TIP" -- \
      'crates/axeyum-lean-kernel/src/**' \
      'crates/axeyum-lean-kernel/tests/support/**' | head -1)" ]; then
    echo "pre-push: Lean kernel source changed — golden module pins" >&2
    step_seconds "golden Lean module pins" \
      env MEM_LIMIT_GB="${MEM_LIMIT_GB:-64}" ./scripts/mem-run.sh \
      ./scripts/check-lean-golden-pins.sh
  else
    echo "pre-push: no Lean kernel source changed — golden module pins SKIPPED" >&2
  fi

  # The `evidence` suite itself is the load-bearing one — `bench-results/PARITY.md`
  # carries a measured `certified / unsat` column, so an evidence route that
  # stops certifying is a headline regression — but it takes ~66s warm, which
  # would roughly double this hook. Gate it on the diff instead: any change under
  # a crate that can move an evidence route must pass it. That is broad by
  # design; the 2026-08-04 drift came from `dl_online.rs`, a file whose name has
  # nothing to do with evidence, and a narrower path filter would have missed it.
  if [ -n "$(git diff --name-only "$PREPUSH_BASE" "$PREPUSH_TIP" -- \
      'crates/axeyum-solver/src/**' \
      'crates/axeyum-rewrite/src/**' | head -1)" ]; then
    echo "pre-push: solver/rewrite source changed — evidence suite" >&2
    # ONE test is this whole suite: `qf_nra_sos_certificate_wrapper_carries_
    # lean_module` measured at **292.973s** of a 293.08s run, because it builds
    # Lean preludes. The other 68 tests together are ~76s, and they are the ones
    # that check evidence PRODUCTION -- which is what a solver/rewrite change can
    # break. The Lean-module wrapper is checked by `lean-gate` and by the
    # reconstruct sweep now in `scripts/check.sh`.
    # 0.06s, and it is the only thing in the tree comparing the DECISION route
    # against the EVIDENCE route on the same query. Two regressions of exactly
    # that shape were found by hand on 2026-08-20, neither by a test.
    gated_test "integration: route agreement" \
      cargo test -p axeyum-solver --features full --quiet \
        --test decision_and_evidence_routes_agree
    gated_test "integration: evidence (minus the Lean-module wrapper)" \
      cargo test -p axeyum-solver --features full --quiet --test evidence \
        -- --skip qf_nra_sos_certificate_wrapper_carries_lean_module
  fi

  # `--lib` compiles ONLY lib targets, so it skips every integration suite in
  # `tests/*.rs`. Two front-door string tests stayed broken across several
  # merges (2026-08-01) because every lane gated on `--lib` plus a targeted
  # `--test <file>`; only the aggregate `just check` caught them. Running all
  # 272 solver integration suites at the push boundary is not viable, so gate
  # the string front door on the diff: if the push touches the parser or the
  # string/regex route, its front-door suites must pass. Everything else keeps
  # the hook's fast default.
  if [ -n "$(git diff --name-only "$PREPUSH_BASE" "$PREPUSH_TIP" -- \
      'crates/axeyum-smtlib/**' \
      'crates/axeyum-solver/src/smtlib.rs' \
      'crates/axeyum-solver/src/*string*' \
      'crates/axeyum-solver/src/*regex*' \
      'crates/axeyum-solver/src/*str*' | head -1)" ]; then
    echo "pre-push: parser/string route changed — front-door integration suites" >&2
    # `--features full` is LOAD-BEARING: all four suites are `#![cfg(feature =
    # "full")]`, so without it each one compiles to an empty binary and reports
    # "running 0 tests ... ok" — an inert gate that is indistinguishable from a
    # passing one. (Caught here by running it: 0 tests without the feature, 155
    # with it.)
    # One invocation PER SUITE so each is individually checked for a nonzero
    # test count: a single `cargo test --test a --test b` call would still pass
    # the emptiness check if only one of the four had been gated out. They share
    # the build, so the extra invocations cost effectively nothing.
    # `string_route_parity` is the only check that relates the workspace's TWO
    # string decision procedures to each other. The shipped composition cannot:
    # the online route only ever fills the bounded route's `unknown` gaps, so a
    # wrong verdict from either is invisible to the other by construction.
    for suite in online_string_front_door word_first_fallback \
                 qf_slia_fixed_splice stoi_len_abstraction \
                 string_route_parity; do
      gated_test "string front door: $suite" \
        cargo test -p axeyum-solver --features full --quiet --test "$suite"
    done
  fi
)
if [ "$(git rev-parse HEAD)" != "$CALLER_HEAD" ] \
   || [ "$(git write-tree)" != "$CALLER_INDEX" ] \
   || [ "$(git status --porcelain=v1)" != "$CALLER_STATUS" ]; then
  echo "pre-push: FAILED - the gate changed this checkout's HEAD, index, or status" >&2
  echo "pre-push:   HEAD   was $CALLER_HEAD now $(git rev-parse HEAD)" >&2
  exit 1
fi
echo "pre-push: gate green (pushed SHA compiles, is formatted, corpus- and unit-sound)" >&2
  # A run that reached here has nothing to debug; keep traces only for deaths.
  rm -f -- "$_pp_trace"
echo "pre-push: total ${SECONDS}s" >&2

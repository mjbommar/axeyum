#!/usr/bin/env bash
# Fail-closed pre-push gate (5th periodic review: mechanism over vigilance).
#
# Catches the class of failure that reached main on 2026-07-03: a pushed SHA
# that does not COMPILE (a shared-index sweep published a re-export one commit
# before its definition — 5ad952b8), and formatting drift.
#
# This is a HEAVY gate, and as of 2026-08-16 that is a deliberate choice rather
# than a drift — but this comment claimed the opposite ("deliberately fast
# (~seconds hot)", "the heavy gates stay in CI") long after the hook had
# acquired the workspace unit sweep, the solver `--lib` sweep, the capability
# frontier ratchet and ten integration suites. Pushes touching no Rust/TOML
# still skip the cargo steps entirely; everything else pays the full battery.
# Measured warm on s4:
#
#   cargo check --workspace          0s     (free once the cache is warm)
#   cargo fmt --all --check          3s
#   corpus :status sweep            13s
#   cargo test --workspace --lib   224s
#   solver unit sweep (full)        31s   (1008 tests; --skip reconstruct::)
#   [moved to `just check`]        294s   (268 reconstruct:: tests, Lean preludes)
#   capability frontier ratchet    216s
#   integration suites x4           ~1s
#   evidence suite                  70s
#   ---------------------------------------
#   total                          557s
#
# Every one of those was added because something reached `main`. The per-step
# seconds are printed on every run so the cost stays visible and future growth
# is a decision rather than a drift.
#
# Gates the PUSHED COMMIT, not the working tree. The old hook ran `cargo check`
# over the working tree, so an unrelated agent's uncommitted WIP (a shared
# checkout always has some) failed the gate for a perfectly good pushed SHA —
# forcing a `--no-verify` that defeats the whole mechanism (happened 2026-07-06).
# We instead check out the exact pushed SHA into a **detached worktree** (never
# `git stash`, which would clobber a sibling lane's WIP) and run the gate there,
# against a persistent `CARGO_TARGET_DIR` that keeps it warm (~seconds hot).
#
# That last claim was FALSE for as long as the worktree came from `mktemp -d`.
# Cargo bakes absolute paths into its fingerprints, so a fresh random path per
# push invalidated every unit and the "warm" cache rebuilt the whole 236k-line
# workspace cold, EVERY TIME -- ~10 minutes a push. Measured 2026-08-16: three
# distinct `/tmp/axeyum-prepush.XXXXXX` paths were baked into one 14 GB shared
# cache. The comment on CARGO_TARGET_DIR below had already identified the
# mechanism (it is why the gate got its own target dir) without noticing it was
# also destroying the gate's own caching.
#
# Worse, `/tmp` here is a 62 G **tmpfs -- RAM**, so every push also extracted a
# full worktree into memory on a box where abandoned snapshots are a documented
# contributor to OOM kills (CLAUDE.md), and `scripts/lane-snapshot.sh` already
# exists to keep this kind of scratch on /data0.
#
# So the worktree path is now STABLE and PER-LANE, on disk, and reused across
# pushes. Per-lane because two lanes pushing at once must not share one checkout
# (the same reason lane identity is $AXEYUM_AGENT); stable because that is the
# entire point of a warm cache.
#
# Install (per checkout): git config core.hooksPath hooks
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
CALLER_HEAD="$(git rev-parse HEAD)"
CALLER_INDEX="$(git write-tree)"
CALLER_STATUS="$(git status --porcelain=v1)"
ZERO=0000000000000000000000000000000000000000

# Collect the distinct pushed SHAs whose diff-to-remote touches Rust/TOML.
# (A branch delete — local_sha all-zero — is skipped; a new branch diffs from
# its merge-base with origin/main.)
shas_to_gate=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    base="$(git merge-base origin/main "$local_sha" 2>/dev/null || echo "$local_sha~20")"
  else
    base="$remote_sha"
  fi
  # `Cargo.lock` IS LOAD-BEARING HERE AND WAS MISSING, so a dependency bump
  # skipped the ENTIRE battery. Measured 2026-08-27 against a real commit:
  #
  #   git diff --name-only f8173a069~1 f8173a069                 -> 4 files
  #   git diff --name-only f8173a069~1 f8173a069 -- '*.rs' '*.toml' -> 0
  #
  # `Cargo.lock` is not `*.toml`, and it decides which source is compiled. That
  # push exited at the "no cargo gate needed" line below while changing the
  # resolved dependency graph of the whole workspace -- the skip-too-much
  # direction, which this file exists to prevent. Widening, not narrowing: this
  # can only cause the battery to run where it previously did not.
  if [ -n "$(git diff --name-only "$base" "$local_sha" -- '*.rs' '*.toml' 'Cargo.lock' | head -1)" ]; then
    shas_to_gate+=("$local_sha")
    # Kept for the path-conditional suites below, which need the diff range and
    # not just the tip SHA.
    PREPUSH_BASE="$base"
    PREPUSH_TIP="$local_sha"
  fi
done
export PREPUSH_BASE PREPUSH_TIP

if [ "${#shas_to_gate[@]}" -eq 0 ]; then
  exit 0 # docs/bench-results/scripts-only push — no cargo gate needed
fi

# Gate the TIP pushed SHA (if several refs are pushed at once, the most recent
# code state is the one that must compile; earlier ones are its ancestors).
target_sha="${shas_to_gate[-1]}"

# A persistent, per-lane detached worktree holding exactly the pushed tree —
# isolated from whatever uncommitted WIP sits in this checkout.
#
# Deliberately NOT `mktemp -d`: see the header. A stable path is what makes the
# cache below actually warm. Prefer a real disk; fall back inside the repo's
# target dir; only then /tmp. Override with $AXEYUM_PREPUSH_ROOT.
gate_root() {
  if [ -n "${AXEYUM_PREPUSH_ROOT:-}" ]; then
    printf '%s\n' "$AXEYUM_PREPUSH_ROOT"; return
  fi
  local base
  for base in /data0/axeyum/prepush "$REPO_ROOT/target/prepush-worktrees"; do
    if mkdir -p "$base" 2>/dev/null && [ -w "$base" ]; then
      printf '%s\n' "$base"; return
    fi
  done
  printf '%s\n' "${TMPDIR:-/tmp}/axeyum-prepush"
}
GATE_ROOT="$(gate_root)"
mkdir -p "$GATE_ROOT"

# ONE root for every lane, serialized by flock — deliberately not per-lane.
#
# Keying this by $AXEYUM_AGENT would give each lane its own COLD cache and its
# own ~14 GB target dir, which is the very cost this change exists to remove.
# Sharing one warm cache and taking the lock is strictly better, and the
# serialization is a feature rather than a price: CLAUDE.md's standing rule on
# this box is one cargo job at a time (parallel cargo has crashed s1 AND s4), so
# two lanes must not run this gate concurrently anyway.
if command -v flock >/dev/null 2>&1; then
  exec 9>"$GATE_ROOT/.lock"
  flock 9
fi

# THIS LOCK IS NOT THE CARGO SEMAPHORE, and confusing the two is what made this
# gate the slowest thing on the box. Measured 2026-08-27
# (docs/research/11-design-review/2026-08-27-gate-throughput.md):
#
#   $GATE_ROOT/.lock                      serializes BATTERY against BATTERY
#   /var/tmp/axeyum-cargo.lock.{1..5}     admits five LANE cargo jobs
#
# They are disjoint. Nothing serialized a battery against a lane, so the gate
# ran as a sixth equal consumer of a 16-core box already carrying five
# `nproc`-wide jobs. Every step inflated ~4-7x and the battery went from ~250 s
# to 2,152 s. It is not a regression in any gate; it is starvation.
#
# Two things follow, and NEITHER drops a step. Correctness is not what is being
# traded here -- only scheduling.
#
# 1. The battery runs at nice 0 while `scripts/cargo-serialized.sh` puts lane
#    work at nice 10. Nothing changes on a quiet box; under oversubscription the
#    interactive gate stops being time-sliced against batch work.
export AXEYUM_CARGO_NICE=0
#
# 2. ADVISORY admission: take a cargo slot if one is free, so the battery is
#    counted against the host's memory budget like everything else, and export
#    the marker so nested wrapper calls do not take a SECOND slot.
#
#    Advisory, and fail-OPEN, deliberately. A scheduling mechanism must never be
#    able to block a correctness gate: if every slot is busy we proceed anyway
#    and say so. The alternative -- a battery that waits for the box -- turns a
#    slow gate into a stalled one, and a lane that cannot push is worse than a
#    lane that pushes slowly. The whole benefit here is the nice level, which
#    needs no lock at all; the slot is a bonus when it is free.
prepush_slot_status="none (all busy — proceeding anyway, this is advisory)"
if command -v flock >/dev/null 2>&1; then
  _cargo_lock="${AXEYUM_CARGO_LOCK:-/var/tmp/axeyum-cargo.lock}"
  _slots="$(scripts/cargo-serialized.sh --slots 2>/dev/null || echo 1)"
  for _i in $(seq 1 "$_slots"); do
    if exec 8>"$_cargo_lock.$_i" 2>/dev/null && flock -n 8 2>/dev/null; then
      prepush_slot_status="slot $_i of $_slots"
      export AXEYUM_CARGO_SLOT_HELD=1
      break
    fi
  done
fi
echo "pre-push: cargo admission — $prepush_slot_status; nice 0 (lanes are nice 10)" >&2

echo "pre-push: Rust/TOML changed — compile + fmt gate on pushed SHA ${target_sha:0:12} (mem-capped)" >&2

# Reuse the worktree when it is one of ours; rebuild it otherwise. `--force`
# plus `clean -xdf` make the tree byte-identical to the pushed commit, so the
# gate still examines exactly what is being pushed and nothing else.
#
# `git checkout` stamps only the files it CHANGES, with the current time — so
# unchanged files keep their mtimes (a legitimate cache hit) and changed ones
# look new. That is why this is safe where `git archive | tar -x` is not: the
# stale-mtime trap in CLAUDE.md comes from tar restoring COMMIT times, which can
# put content behind a warm cache and let a gate pass over code it never
# compiled. Checkout cannot do that.
tmp_wt="$(scripts/prepare-prepush-worktree.sh "$REPO_ROOT" "$GATE_ROOT" "$target_sha")"

# A DEDICATED target dir for the gate — persistent, so it stays warm across
# pushes, but NOT shared with the main checkout's.
#
# Sharing `$REPO_ROOT/target` poisoned the main checkout (observed 2026-08-01):
# this gate compiles inside a throwaway `/tmp/axeyum-prepush.XXXX` worktree, so
# the test binaries it produces bake THAT path into `CARGO_MANIFEST_DIR`. Cargo
# then considers the artifact fresh for the main checkout too — same package,
# same features — and the main checkout silently reuses a binary whose manifest
# dir no longer exists. The symptom is a corpus test failing with
# `read_dir(/tmp/axeyum-prepush.ll4jFr/...): No such file or directory` on a
# tree that is perfectly fine, and `cargo test -p <pkg> --lib` passing while
# `cargo test --workspace --lib` fails (different feature unification selects a
# different cached binary). Recovery was `cargo clean -p axeyum-cnf`; the fix is
# to never let this gate write artifacts the main build will pick up.
# Kept beside the worktree so the pair moves together and stays per-lane: two
# lanes sharing one target dir would thrash each other's fingerprints for the
# same path reason described in the header.
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$GATE_ROOT/target}"
(
  cd "$tmp_wt"

  # Runs a cargo test step and FAILS IF IT RAN NOTHING. `cargo test` exits 0 on
  # an empty test binary, so a suite that has been `#![cfg]`-ed out of the
  # selected feature set is indistinguishable from a passing one by exit status
  # alone — which is exactly how the corpus sweep below sat inert for 15 days
  # (see its comment). Mechanism over vigilance: any future feature gate that
  # empties a suite now breaks the push instead of quietly passing it.
  # Per-step wall clock, always reported. A gate whose cost is invisible grows
  # without anyone deciding to grow it: this hook's header still described a
  # "deliberately fast (~seconds hot)" compile-and-fmt check long after it had
  # acquired the workspace unit sweep, the solver `--lib` sweep, the capability
  # frontier ratchet and ten integration suites. Printing the seconds is what
  # makes that visible at the moment someone is paying for it.
  step_seconds() {
    local start=$SECONDS label="$1"
    shift
    "$@" || return 1
    echo "pre-push:   ${label} — $((SECONDS - start))s" >&2
  }

  gated_test() {
    local label="$1"
    shift
    local out start=$SECONDS
    if ! out="$(MEM_LIMIT_GB="${MEM_LIMIT_GB:-64}" ./scripts/mem-run.sh "$@" 2>&1)"; then
      printf '%s\n' "$out" >&2
      echo "pre-push: FAILED — $label" >&2
      return 1
    fi
    # `grep -c`, not `grep -q`. This is THE nonzero-test-count guard -- the one
    # CLAUDE.md leans on hardest, because a feature-gated suite prints
    # "running 0 tests ... ok" and exits 0 -- and it was built from the idiom
    # that reads a SIGPIPE as "no match": `-q` exits at the first match,
    # SIGPIPEs the `printf`, and `pipefail` (set above) turns 141 into a
    # non-match, so the negation fires and a passing step is reported as inert.
    # Fail-closed, so it cost a spurious push block rather than an admitted bad
    # push -- but it went unscanned until `check-shell-antipatterns.sh` learned
    # to read `hooks/` on 2026-08-30. `grep -c` consumes all input.
    if [ "$(printf '%s\n' "$out" | grep -cE '^running [1-9]')" -eq 0 ]; then
      printf '%s\n' "$out" >&2
      echo "pre-push: FAILED — $label ran ZERO tests (a feature gate has emptied" \
           "it; this step is inert, not passing)" >&2
      return 1
    fi
    echo "pre-push:   ${label} — $((SECONDS - start))s" >&2
  }

  gate_started=$SECONDS
  # `--all-targets` IS LOAD-BEARING, and its absence let a non-compiling
  # workspace onto `main` on 2026-08-20 under the message "pushed SHA compiles".
  #
  # `cargo check --workspace` builds lib and bin targets and NOT `examples/` or
  # `tests/`. Adding one `Evidence` variant broke the exhaustive `match` in
  # `crates/axeyum-bench/examples/{audit_dominance,diagnose_evidence}.rs`; this
  # step passed, the hook printed its green line, and the break was found later
  # by running one of those examples by hand. The type system had the answer the
  # whole time — the gate simply never asked the compiler about half the tree.
  #
  # It is close to free: measured on this host, 13s cold and **0s warm**, against
  # a step already documented at 0s. `scripts/check.sh` was never blind to this
  # (its clippy wrapper is `--all-targets`), so the aggregate gate would have
  # caught it — which is exactly why the narrower gate must not claim
  # "compiles" for a subset of what compiles.
  #
  # Control: scripts/tests/test-prepush-checks-all-targets.sh
  step_seconds "cargo check --workspace --all-targets" \
    env MEM_LIMIT_GB="${MEM_LIMIT_GB:-64}" ./scripts/mem-run.sh cargo check --workspace --all-targets --quiet
  step_seconds "cargo fmt --all --check" cargo fmt --all --check
  # The oracle-free :status corpus sweep (~6s warm): CI's copy caught a
  # vacuous-sat harness hole (f5b00c72) only AFTER the SHA was public —
  # a wrong verdict must never leave the machine when a 6-second local
  # sweep can catch it.
  #
  # `--features full` is LOAD-BEARING and its absence made THIS GATE ITSELF
  # VACUOUS for 15 days: `4464dae2` (2026-07-17, "make qfbv the audited
  # deployment default") put `#![cfg(feature = "full")]` on the suite, so from
  # that commit until 2026-08-01 this step compiled an empty test binary and
  # printed "running 0 tests ... ok". A gate built to catch a vacuous-sat hole
  # had itself become vacuous, and it looked green the entire time. Every
  # `--test <name>` line in this hook must be spot-checked for a nonzero test
  # count, not merely for a zero exit status.
  gated_test "corpus :status sweep" \
    cargo test -p axeyum-solver --features full --test corpus_regression --quiet
  # The WORKSPACE unit sweep (~40s warm): a wrong-unsat unit test
  # (int_mod_by_zero_underspecification, 52f3b1d1) shipped to main because a
  # lane ran targeted `--test <file>` + fuzzes but not `--lib` — the corpus
  # sweep above misses soundness holes on shapes that are neither in the
  # committed corpus nor hit by a differential-fuzz generator. Scoped to the
  # WHOLE workspace, not `-p axeyum-solver`: that P0's defect actually lived in
  # `axeyum-rewrite` (8th-review finding), so a solver-only sweep is a
  # half-measure — a soundness hole reachable only through a rewrite/strings/bv
  # unit test would still slip. ("full sweep catches what per-commit --test
  # misses", enforced workspace-wide at the push boundary.)
  # THE WORKSPACE UNIT SWEEP MOVED OUT on 2026-08-19. It ran `cargo test
  # --workspace --lib` on every Rust push: 218 s uncontended at its last honest
  # measurement, and **2,699 s** in a real push once `axeyum-lean-kernel`'s lib
  # tests grew (CReal, its inverse, the lattice, and Complex all landed in that
  # crate in a day; a dozen of its tests now exceed 60 s each). It was also
  # DOUBLE-CHARGED: the kernel step below ran `-p axeyum-lean-kernel` wholesale,
  # which includes the same `--lib` tests.
  #
  # It exists because a P0 wrong-unsat lived in `axeyum-rewrite`, not in the
  # solver, so a `-p axeyum-solver` sweep would not have caught it. That coverage
  # is NOT lost: `cargo nextest run --profile local --workspace --all-features`
  # in `scripts/local-ci.sh` is a strict superset, and
  # `scripts/check-local-ci-freshness.sh` is ENFORCING in `just check` and
  # `scripts/check.sh` — a battery record that is stale, failing, vacuous or
  # unreadable reds the aggregate gate. The battery moved from every-push to
  # must-have-run-recently, which is the cadence it was always worth.

  # ...and the step above runs on DEFAULT features, under which `axeyum-solver`
  # compiles **23** of its **968** unit tests (measured 2026-08-01): everything
  # behind `#[cfg(feature = "full")]` — the whole multi-theory surface, strings,
  # e-graph, FP, smtlib — silently vanishes. The wrong-unsat that motivated the
  # sweep above would have been caught either way, but a soundness hole in any
  # `full`-gated module would sail through a "green" workspace sweep. `full` is
  # pure Rust (the C/C++ z3 backend is a separate feature), so requiring it here
  # keeps the no-C-dependency promise intact.
  # `--skip reconstruct::` is why this step is 31s and not 294s.
  #
  # Measured 2026-08-20 on an IDLE box (load 1.03, zero other cargo): the 1008
  # solver unit tests run in **31s**; the 268 `reconstruct::` tests take
  # **294s**, because each builds Lean preludes. They were 90% of this step and
  # ~45% of the entire push, on every push touching a single `.rs` file.
  #
  # They are not what this step exists for. The sweep was added because a
  # wrong-`unsat` unit test shipped (52f3b1d1) — a SOLVER soundness defect. The
  # `reconstruct::` tests check that a Lean module is built correctly, which is
  # a different property, caught by `lean-gate` and by the reconstruct sweep now
  # registered in `scripts/check.sh` and the justfile. Nothing is dropped; the
  # daily gate keeps them and every git round stops paying for them.
  #
  # The comment at the top of this file said this step cost 30s. That was true
  # once. Timings in a comment rot; these were re-measured today.
  gated_test "solver unit sweep (full, minus Lean reconstruction)" \
    cargo test -p axeyum-solver --lib --features full --quiet -- --skip reconstruct::

  # The KERNEL's integration suites. `cargo test --workspace --lib` above runs
  # unit tests only and SKIPS every `tests/*.rs`, which is how
  # `axeyum-lean-kernel --test axiom_footprint` sat RED on main for a day: the
  # commit that made `Int.euclidean_decomposition` a theorem left three
  # assertions still describing it as an axiom, and nothing at push time looked.
  # CLAUDE.md warns about exactly this ("`--lib` IS NOT A SUFFICIENT PRE-MERGE
  # GATE ON ITS OWN"), and the warning was not enough on its own.
  #
  # This is the crate where the trusted surface is asserted, so a stale
  # assertion here is a stale claim about axiom-freedom. That coverage is why
  # the step exists and it is NOT being reduced.
  #
  # SPLIT, 2026-08-19, because it ran the crate WHOLESALE. Fifteen of the crate's
  # 46 integration suites hand generated modules to a real `lean`, and
  # `scripts/check-lean-gate.sh` already owns those -- with a toolchain pin, a
  # counted floor and a no-skip rule, none of which this step had. So every push
  # ran them twice, and the comment here said "~1.4s warm". Measured warm on s4
  # 2026-08-19, in a snapshot tree whose target dir was already built:
  #   BEFORE  cargo test -p axeyum-lean-kernel            2,296 s
  #   AFTER   check-kernel-suites.sh --no-lib                80 s  (31 suites, 188 tests)
  # for a hook that runs 722-1,176 s in total when healthy.
  #
  # `scripts/check-kernel-suites.sh` DISCOVERS which half a suite is in (it
  # carries `#[path = "support/lean_probe.rs"]`, or it does not) and FAILS if any
  # suite is in neither -- so removing the duplication cannot silently create a
  # suite that nothing runs. It found one the first time it ran.
  #
  # `--no-lib`: the workspace unit sweep two steps above already runs this
  # crate's unit tests, and several of them take over 60 s each.
  #
  # SCOPED TO THE DIFF, and unlike the frontier ratchet's filter this one is
  # DERIVED rather than judged: `crates/axeyum-lean-kernel/Cargo.toml` has
  # exactly one dependency, `num-bigint`, and nothing from this workspace. No
  # change under another crate can move these suites. The manifests are in the
  # filter for the lint/version surface, and the two gate scripts for their own
  # sake. The partition assertion is cheap (no cargo) and runs EITHER WAY: it is
  # what makes the skip safe, since it is the thing that notices a real-Lean
  # suite dropping out of `check-lean-gate.sh`'s table.
  if [ -n "$(git diff --name-only "$PREPUSH_BASE" "$PREPUSH_TIP" -- \
      'crates/axeyum-lean-kernel/**' \
      'scripts/check-kernel-suites.sh' \
      'scripts/check-lean-gate.sh' \
      'Cargo.toml' 'Cargo.lock' | head -1)" ]; then
    echo "pre-push: Lean kernel changed — kernel suites (non-Lean integration)" >&2
    step_seconds "kernel suites (non-Lean integration)" \
      env MEM_LIMIT_GB="${MEM_LIMIT_GB:-64}" ./scripts/mem-run.sh \
      ./scripts/check-kernel-suites.sh --no-lib
  else
    echo "pre-push: no Lean kernel change — kernel suites SKIPPED (partition still asserted)" >&2
    step_seconds "kernel suite partition" ./scripts/check-kernel-suites.sh --list
  fi

  # THE CAPABILITY FRONTIER RATCHET MOVED OUT on 2026-08-19, to
  # `scripts/local-ci.sh`, where it runs serialized with `--test-threads=1`.
  #
  # It exists because a 17-point `nia_unsat` regression once shipped and needed
  # an 829-commit bisect: it is the only gate that notices we got WEAKER without
  # getting WRONG. That is worth keeping, and it is kept — but not here.
  #
  # Moving it makes it STRONGER, which is the only reason it was allowed to
  # move. It measures the largest N decided within a fixed WALL-CLOCK budget, so
  # contention does not slow it down, it corrupts it: CLAUDE.md records the same
  # commit on the same box scoring 35 (load 34), 39 (load 5.4) and 40 (idle).
  # Each family calibrates the machine and marks a run NOT COMPARABLE or
  # ADVISORY ONLY when the frame moved. In this hook, with several lanes on the
  # box, it was **200 s of a 545 s baseline** spent mostly being advisory —
  # paying full price for a verdict it then declined to enforce.
  #
  # `scripts/check-local-ci-freshness.sh` is ENFORCING in `just check` and
  # `scripts/check.sh`, so a battery record that is stale, failing, vacuous or
  # unreadable reds the aggregate gate. The ratchet did not become optional; it
  # became something that must have run recently.

  # The ALWAYS-ON integration slice: four cheap `tests/*.rs` suites (measured
  # 2026-08-04: 0.00s + 0.01s + 0.00s + 0.82s warm) that no fast gate ran.
  #
  # All four were FAILING on main on 2026-08-04, one of them
  # (`deep_nesting_no_abort::deep_int_add_source_returns`) with a STACK
  # OVERFLOW — an abort, which is strictly worse than a timeout because the
  # solver cannot report the first-class `unknown` it owes its caller and a
  # harness reads the exit as a crash. They failed identically at older commits,
  # so this was accumulated drift, invisible because every fast gate is `--lib`
  # (which skips `tests/*.rs` entirely) and the only gate that would have caught
  # them, `./scripts/check.sh --workspace --all-features`, needs libz3 and tens
  # of minutes. Cheap suites that pin a load-bearing invariant belong here, not
  # only in the aggregate gate.
  #
  #   capabilities            — the capability-matrix golden; the trust metadata
  #                             users read must equal what the ledger renders.
  #   deep_nesting_no_abort   — the no-abort ratchet for source-controlled
  #                             nesting depth (`unknown` is a hard-rule result;
  #                             SIGABRT is not a result at all).
  #   evidence_lia_cert       — arithmetic UNSAT certificates re-check, and a
  #   evidence_bv2nat_cert      tampered one is REJECTED.
  #
  # `--features full` is LOAD-BEARING on every one: all four are
  # `#![cfg(feature = "full")]`, so without it each compiles to an empty binary
  # that prints "running 0 tests ... ok". `gated_test` fails on a zero count, so
  # that trap is mechanised rather than remembered.
  for suite in capabilities deep_nesting_no_abort \
               evidence_lia_cert evidence_bv2nat_cert; do
    gated_test "integration: $suite" \
      cargo test -p axeyum-solver --features full --quiet --test "$suite"
  done

  # The GOLDEN LEAN MODULE pins, diff-scoped to the crate that renders them.
  #
  # Every module the kernel renders opens with a fixed banner, and until
  # 2026-08-18 that banner was inside every golden byte pin in the workspace. A
  # commit that changed it re-pinned the goldens it happened to run and shipped
  # the same delta unannounced onto the rest -- THREE times (`0fc7cc357`,
  # `b760fd6ae` +863, `46724faec` +777). `main` was red for a day and the first
  # ever completed `scripts/local-ci.sh` run found it, 6,400 seconds in.
  #
  # The pins now cover the module BODY and the banner has its own committed-text
  # pin, so a header change fails one named thing instead of five unnamed ones.
  # This step is the other half: those five are `tests/*.rs` integration targets,
  # which `--lib` skips by construction and which this hook -- naming six of the
  # workspace's 465 -- did not name.
  #
  # Scoped to `axeyum-lean-kernel/src/**` because that is where all three
  # recurrences came from: two from `lean_pp.rs` (the banner itself) and one from
  # `int_prelude.rs` (axioms became theorems, so their proof terms are emitted).
  # A solver-side reconstruction change can also move a body pin; that is caught
  # by `just check` / `scripts/check.sh`, where this same script always runs.
  # Measured warm on s4: see docs/plan/notes/agent-golden-pins.md.
  if [ -n "$(git diff --name-only "$PREPUSH_BASE" "$PREPUSH_TIP" -- \
      'crates/axeyum-lean-kernel/src/**' \
      'crates/axeyum-lean-kernel/tests/support/**' | head -1)" ]; then
    echo "pre-push: Lean kernel source changed — golden module pins" >&2
    step_seconds "golden Lean module pins" \
      env MEM_LIMIT_GB="${MEM_LIMIT_GB:-64}" ./scripts/mem-run.sh \
      ./scripts/check-lean-golden-pins.sh
  else
    echo "pre-push: no Lean kernel source changed — golden module pins SKIPPED" >&2
  fi

  # The `evidence` suite itself is the load-bearing one — `bench-results/PARITY.md`
  # carries a measured `certified / unsat` column, so an evidence route that
  # stops certifying is a headline regression — but it takes ~66s warm, which
  # would roughly double this hook. Gate it on the diff instead: any change under
  # a crate that can move an evidence route must pass it. That is broad by
  # design; the 2026-08-04 drift came from `dl_online.rs`, a file whose name has
  # nothing to do with evidence, and a narrower path filter would have missed it.
  if [ -n "$(git diff --name-only "$PREPUSH_BASE" "$PREPUSH_TIP" -- \
      'crates/axeyum-solver/src/**' \
      'crates/axeyum-rewrite/src/**' | head -1)" ]; then
    echo "pre-push: solver/rewrite source changed — evidence suite" >&2
    # ONE test is this whole suite: `qf_nra_sos_certificate_wrapper_carries_
    # lean_module` measured at **292.973s** of a 293.08s run, because it builds
    # Lean preludes. The other 68 tests together are ~76s, and they are the ones
    # that check evidence PRODUCTION -- which is what a solver/rewrite change can
    # break. The Lean-module wrapper is checked by `lean-gate` and by the
    # reconstruct sweep now in `scripts/check.sh`.
    # 0.06s, and it is the only thing in the tree comparing the DECISION route
    # against the EVIDENCE route on the same query. Two regressions of exactly
    # that shape were found by hand on 2026-08-20, neither by a test.
    gated_test "integration: route agreement" \
      cargo test -p axeyum-solver --features full --quiet \
        --test decision_and_evidence_routes_agree
    gated_test "integration: evidence (minus the Lean-module wrapper)" \
      cargo test -p axeyum-solver --features full --quiet --test evidence \
        -- --skip qf_nra_sos_certificate_wrapper_carries_lean_module
  fi

  # `--lib` compiles ONLY lib targets, so it skips every integration suite in
  # `tests/*.rs`. Two front-door string tests stayed broken across several
  # merges (2026-08-01) because every lane gated on `--lib` plus a targeted
  # `--test <file>`; only the aggregate `just check` caught them. Running all
  # 272 solver integration suites at the push boundary is not viable, so gate
  # the string front door on the diff: if the push touches the parser or the
  # string/regex route, its front-door suites must pass. Everything else keeps
  # the hook's fast default.
  if [ -n "$(git diff --name-only "$PREPUSH_BASE" "$PREPUSH_TIP" -- \
      'crates/axeyum-smtlib/**' \
      'crates/axeyum-solver/src/smtlib.rs' \
      'crates/axeyum-solver/src/*string*' \
      'crates/axeyum-solver/src/*regex*' \
      'crates/axeyum-solver/src/*str*' | head -1)" ]; then
    echo "pre-push: parser/string route changed — front-door integration suites" >&2
    # `--features full` is LOAD-BEARING: all four suites are `#![cfg(feature =
    # "full")]`, so without it each one compiles to an empty binary and reports
    # "running 0 tests ... ok" — an inert gate that is indistinguishable from a
    # passing one. (Caught here by running it: 0 tests without the feature, 155
    # with it.)
    # One invocation PER SUITE so each is individually checked for a nonzero
    # test count: a single `cargo test --test a --test b` call would still pass
    # the emptiness check if only one of the four had been gated out. They share
    # the build, so the extra invocations cost effectively nothing.
    # `string_route_parity` is the only check that relates the workspace's TWO
    # string decision procedures to each other. The shipped composition cannot:
    # the online route only ever fills the bounded route's `unknown` gaps, so a
    # wrong verdict from either is invisible to the other by construction.
    for suite in online_string_front_door word_first_fallback \
                 qf_slia_fixed_splice stoi_len_abstraction \
                 string_route_parity; do
      gated_test "string front door: $suite" \
        cargo test -p axeyum-solver --features full --quiet --test "$suite"
    done
  fi
)
if [ "$(git rev-parse HEAD)" != "$CALLER_HEAD" ] \
   || [ "$(git write-tree)" != "$CALLER_INDEX" ] \
   || [ "$(git status --porcelain=v1)" != "$CALLER_STATUS" ]; then
  echo "pre-push: FAILED - the gate changed this checkout's HEAD, index, or status" >&2
  echo "pre-push:   HEAD   was $CALLER_HEAD now $(git rev-parse HEAD)" >&2
  exit 1
fi
echo "pre-push: gate green (pushed SHA compiles, is formatted, corpus- and unit-sound)" >&2
echo "pre-push: total ${SECONDS}s" >&2
